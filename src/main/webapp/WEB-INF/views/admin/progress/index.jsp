<%@ page pageEncoding="UTF-8" %>
<%@ include file="../../fragments/head.jspf" %>
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/study-tracking.css"/>
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/admin-study-tracking.css?v=32.1"/>
<main data-n11-src="admin/progress/index.jsp|1" class="admin-shell n11-tracking"><div data-n11-src="admin/progress/index.jsp|2" class="container container-n11"><div data-n11-src="admin/progress/index.jsp|3" class="row g-4"><div data-n11-src="admin/progress/index.jsp|4" class="col-lg-3"><%@ include file="../../fragments/admin-sidebar.jspf" %></div><div data-n11-src="admin/progress/index.jsp|5" class="col-lg-9">
<section data-n11-src="admin/progress/index.jsp|6" class="reading-admin-hero n11-tracking-hero mb-4"><div data-n11-src="admin/progress/index.jsp|7"><h1 data-n11-src="admin/progress/index.jsp|8">Tiến độ & thống kê</h1><p data-n11-src="admin/progress/index.jsp|9">Theo dõi kết quả học tập từ dữ liệu bài đã nộp.</p></div></section>
<section data-n11-src="admin/progress/index.jsp|10" class="panel-card mb-4"><form data-n11-src="admin/progress/index.jsp|11" class="row g-3 align-items-end" method="get" action="${pageContext.request.contextPath}/admin/progress"><div data-n11-src="admin/progress/index.jsp|12" class="col-md-4"><label data-n11-src="admin/progress/index.jsp|13" class="form-label">Thời gian</label><select data-n11-src="admin/progress/index.jsp|14" class="form-select" name="days"><option value="7" ${days eq 7 ? 'selected' : ''}>7 ngày</option><option value="30" ${days eq 30 ? 'selected' : ''}>30 ngày</option><option value="0" ${days eq 0 ? 'selected' : ''}>Tất cả</option></select></div><div data-n11-src="admin/progress/index.jsp|15" class="col-md-5"><label data-n11-src="admin/progress/index.jsp|16" class="form-label">Tìm học viên</label><input data-n11-src="admin/progress/index.jsp|17" class="form-control" name="q" value="${fn:escapeXml(q)}" placeholder="Tên hoặc email"/></div><div data-n11-src="admin/progress/index.jsp|18" class="col-md-3"><button data-n11-src="admin/progress/index.jsp|19" class="btn btn-primary w-100">Lọc</button></div></form><small data-n11-src="admin/progress/index.jsp|20" class="d-block mt-2">Tổng số tài khoản học viên: ${studentCount}. Bộ lọc tên chỉ áp dụng bảng học viên.</small></section><div data-n11-src="admin/progress/index.jsp|21" class="row g-3 mb-4"><div data-n11-src="admin/progress/index.jsp|22" class="col-sm-6 col-xl-3"><div data-n11-src="admin/progress/index.jsp|23" class="panel-card n11-stat"><small data-n11-src="admin/progress/index.jsp|24">Lượt đã nộp</small><strong data-n11-src="admin/progress/index.jsp|25">${totals.attempts}</strong></div></div><div data-n11-src="admin/progress/index.jsp|26" class="col-sm-6 col-xl-3"><div data-n11-src="admin/progress/index.jsp|27" class="panel-card n11-stat"><small data-n11-src="admin/progress/index.jsp|28">Tỷ lệ đúng luyện tập (%)</small><strong data-n11-src="admin/progress/index.jsp|29">${empty totals.accuracy ? "—" : totals.accuracy}</strong></div></div><div data-n11-src="admin/progress/index.jsp|30" class="col-sm-6 col-xl-3"><div data-n11-src="admin/progress/index.jsp|31" class="panel-card n11-stat"><small data-n11-src="admin/progress/index.jsp|32">Điểm thi thử TB</small><strong data-n11-src="admin/progress/index.jsp|33">${empty totals.exam_average ? "—" : totals.exam_average}</strong></div></div><div data-n11-src="admin/progress/index.jsp|34" class="col-sm-6 col-xl-3"><div data-n11-src="admin/progress/index.jsp|35" class="panel-card n11-stat"><small data-n11-src="admin/progress/index.jsp|36">Học viên có lượt nộp</small><strong data-n11-src="admin/progress/index.jsp|37">${totals.active_students}</strong></div></div></div><section data-n11-src="admin/progress/index.jsp|38" class="panel-card mb-4"><h2 data-n11-src="admin/progress/index.jsp|39" class="account-section-title">Kết quả theo kỹ năng</h2><div data-n11-src="admin/progress/index.jsp|40" class="table-responsive"><table data-n11-src="admin/progress/index.jsp|41" class="table align-middle"><thead data-n11-src="admin/progress/index.jsp|42"><tr data-n11-src="admin/progress/index.jsp|43"><th data-n11-src="admin/progress/index.jsp|44">Kỹ năng</th><th data-n11-src="admin/progress/index.jsp|45">Lượt nộp</th><th data-n11-src="admin/progress/index.jsp|46">Số câu đúng / tổng</th><th data-n11-src="admin/progress/index.jsp|47">Tỷ lệ đúng (%)</th><th data-n11-src="admin/progress/index.jsp|48">Điểm thi thử TB</th></tr></thead><tbody data-n11-src="admin/progress/index.jsp|49"><c:forEach items="${skills}" var="s"><tr data-n11-src="admin/progress/index.jsp|50"><td data-n11-src="admin/progress/index.jsp|51"><c:choose><c:when test="${s.skill eq 'VOCAB'}">Từ vựng</c:when><c:when test="${s.skill eq 'GRAMMAR'}">Ngữ pháp</c:when><c:when test="${s.skill eq 'EXAM'}">Thi thử</c:when><c:otherwise><c:out value="${s.skill}"/></c:otherwise></c:choose></td><td data-n11-src="admin/progress/index.jsp|52">${s.attempts}</td><td data-n11-src="admin/progress/index.jsp|53"><c:choose><c:when test="${s.skill eq 'EXAM'}">—</c:when><c:otherwise>${s.correct}/${s.total}</c:otherwise></c:choose></td><td data-n11-src="admin/progress/index.jsp|54">${empty s.accuracy ? '—' : s.accuracy}</td><td data-n11-src="admin/progress/index.jsp|55">${empty s.exam_average ? '—' : s.exam_average}</td></tr></c:forEach><c:if test="${empty skills}"><tr data-n11-src="admin/progress/index.jsp|56"><td data-n11-src="admin/progress/index.jsp|57" colspan="5" class="text-center py-4">Chưa có lượt nộp trong khoảng thời gian này.</td></tr></c:if></tbody></table></div></section><section data-n11-src="admin/progress/index.jsp|58" class="panel-card mb-4"><h2 data-n11-src="admin/progress/index.jsp|59" class="account-section-title">Lượt nộp trong 7 ngày gần nhất</h2><p data-n11-src="admin/progress/index.jsp|86" class="small-meta">Hiển thị những ngày có lượt nộp; độ dài thanh tính theo ngày có nhiều lượt nhất.</p><c:forEach items="${daily}" var="d"><div data-n11-src="admin/progress/index.jsp|60" class="n11-activity"><span data-n11-src="admin/progress/index.jsp|61">${d.day}</span><progress data-n11-src="admin/progress/index.jsp|87" class="n11-meter" aria-label="Lượt nộp ngày ${d.day}" value="${d.attempts}" max="${dailyMax gt 0 ? dailyMax : 1}"></progress><strong data-n11-src="admin/progress/index.jsp|62">${d.attempts} lượt</strong></div></c:forEach><c:if test="${empty daily}"><p data-n11-src="admin/progress/index.jsp|63">Chưa có hoạt động.</p></c:if></section><section data-n11-src="admin/progress/index.jsp|64" class="panel-card"><h2 data-n11-src="admin/progress/index.jsp|65" class="account-section-title">Kết quả từng học viên</h2><div data-n11-src="admin/progress/index.jsp|66" class="table-responsive"><table data-n11-src="admin/progress/index.jsp|67" class="table align-middle"><thead data-n11-src="admin/progress/index.jsp|68"><tr data-n11-src="admin/progress/index.jsp|69"><th data-n11-src="admin/progress/index.jsp|70">Học viên</th><th data-n11-src="admin/progress/index.jsp|71">Lượt nộp</th><th data-n11-src="admin/progress/index.jsp|72">Tỷ lệ đúng (%)</th><th data-n11-src="admin/progress/index.jsp|73">Điểm thi TB</th></tr></thead><tbody data-n11-src="admin/progress/index.jsp|74"><c:forEach items="${students}" var="s"><tr data-n11-src="admin/progress/index.jsp|75"><td data-n11-src="admin/progress/index.jsp|76"><c:out value="${s.full_name}"/><small data-n11-src="admin/progress/index.jsp|77" class="d-block"><c:out value="${s.email}"/></small></td><td data-n11-src="admin/progress/index.jsp|78">${s.attempts}</td><td data-n11-src="admin/progress/index.jsp|79">${empty s.accuracy ? '—' : s.accuracy}</td><td data-n11-src="admin/progress/index.jsp|80">${empty s.exam_average ? '—' : s.exam_average}</td></tr></c:forEach><c:if test="${empty students}"><tr data-n11-src="admin/progress/index.jsp|81"><td data-n11-src="admin/progress/index.jsp|82" colspan="4" class="text-center py-4">Không có học viên phù hợp.</td></tr></c:if></tbody></table></div><div data-n11-src="admin/progress/index.jsp|83" class="d-flex gap-2"><c:if test="${p gt 0}"><a data-n11-src="admin/progress/index.jsp|84" class="btn btn-soft btn-sm" href="<c:url value='/admin/progress'><c:param name='days' value='${days}'/><c:param name='q' value='${q}'/><c:param name='p' value='${p-1}'/></c:url>">← Trước</a></c:if><c:if test="${fn:length(students) eq 25}"><a data-n11-src="admin/progress/index.jsp|85" class="btn btn-soft btn-sm" href="<c:url value='/admin/progress'><c:param name='days' value='${days}'/><c:param name='q' value='${q}'/><c:param name='p' value='${p+1}'/></c:url>">Sau →</a></c:if></div></section></div></div></div></main>
<%@ include file="../../fragments/scripts.jspf" %>
