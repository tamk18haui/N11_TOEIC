<%@ page pageEncoding="UTF-8" %>
<%@ include file="../fragments/head.jspf" %>
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/admin-exams-v33.css"/>
<main data-n11-src="admin/exams.jsp|1" class="admin-shell n11-admin-content n11-exam-admin"><div data-n11-src="admin/exams.jsp|2" class="container container-n11"><div data-n11-src="admin/exams.jsp|3" class="row g-4">
<div data-n11-src="admin/exams.jsp|4" class="col-lg-3"><%@ include file="../fragments/admin-sidebar.jspf" %></div><div data-n11-src="admin/exams.jsp|5" class="col-lg-9 n11-content-main">
<header data-n11-src="admin/exams.jsp|6" class="n11-content-hero"><div data-n11-src="admin/exams.jsp|7"><div data-n11-src="admin/exams.jsp|8" class="section-caption">QUẢN LÝ ĐỀ THI</div><h1 data-n11-src="admin/exams.jsp|9" class="account-title">Ngân hàng đề TOEIC</h1><p data-n11-src="admin/exams.jsp|10" class="small-meta mb-0">Tạo đề từ ngân hàng Listening và Reading, quản lý công bố.</p></div><a data-n11-src="admin/exams.jsp|900" class="btn btn-soft" href="${pageContext.request.contextPath}/admin/exams/offline">Nhập đề offline / Nguồn media</a></header>
<!-- N11 V39 EXAM MEDIA ACTIONS -->
<section data-n11-src="admin/exams.jsp|910" class="panel-card mb-4">
 <div data-n11-src="admin/exams.jsp|911" class="d-flex flex-wrap justify-content-between align-items-center gap-3">
  <div data-n11-src="admin/exams.jsp|912"><h2 data-n11-src="admin/exams.jsp|913" class="account-section-title mb-1">Nguồn đề thi &amp; đồng bộ media</h2>
   <p data-n11-src="admin/exams.jsp|914" class="small-meta mb-0">Nhập đề offline, sau đó đồng bộ audio và hình ảnh Local trong toàn bộ bảng media_assets để các thành viên dùng chung.</p></div>
  <div data-n11-src="admin/exams.jsp|915" class="d-flex flex-wrap gap-2">
   <a data-n11-src="admin/exams.jsp|916" class="btn btn-soft" href="${pageContext.request.contextPath}/admin/exams/offline">Nhập đề offline / Cài đặt nguồn</a>
   <a data-n11-src="admin/exams.jsp|917" class="btn btn-primary" href="${pageContext.request.contextPath}/admin/exams/offline/media-sync">Đồng bộ tất cả media lên Cloudinary</a>
  </div>
 </div>
</section>
<!-- /N11 V39 EXAM MEDIA ACTIONS -->
<c:if test="${not empty successMessage}"><div data-n11-src="admin/exams.jsp|11" class="alert alert-success" role="status"><c:out value="${successMessage}"/></div></c:if>
<c:if test="${not empty errorMessage}"><div data-n11-src="admin/exams.jsp|12" class="alert alert-danger" role="alert"><c:out value="${errorMessage}"/></div></c:if><details data-n11-src="admin/exams.jsp|13" class="panel-card mb-4"><summary data-n11-src="admin/exams.jsp|14" class="account-section-title">+ Tạo đề thi</summary>
<form data-n11-src="admin/exams.jsp|15" method="post" action="${pageContext.request.contextPath}/admin/exams" class="row g-3 mt-1"><input data-n11-src="admin/exams.jsp|16" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/>
<div data-n11-src="admin/exams.jsp|17" class="col-md-8"><label data-n11-src="admin/exams.jsp|18" for="new-title" class="form-label">Tên đề</label><input data-n11-src="admin/exams.jsp|19" id="new-title" name="title" maxlength="220" required class="form-control" placeholder="TOEIC Test 01"/></div>
<div data-n11-src="admin/exams.jsp|20" class="col-md-4"><label data-n11-src="admin/exams.jsp|21" for="new-type" class="form-label">Loại đề</label><select data-n11-src="admin/exams.jsp|22" id="new-type" class="form-select" name="type"><option value="LR_FULL">Full Test</option><option value="LR_CUSTOM">Đề tùy chọn</option></select></div>
<div data-n11-src="admin/exams.jsp|23" class="col-md-4"><label data-n11-src="admin/exams.jsp|24" for="new-duration" class="form-label">Thời gian (phút)</label><input data-n11-src="admin/exams.jsp|25" id="new-duration" class="form-control" name="duration" type="number" min="1" max="180" value="120" required/></div>
<div data-n11-src="admin/exams.jsp|26" class="col-md-8"><label data-n11-src="admin/exams.jsp|27" for="new-description" class="form-label">Mô tả</label><textarea data-n11-src="admin/exams.jsp|28" id="new-description" name="description" class="form-control" rows="2" maxlength="5000"></textarea></div>
<div data-n11-src="admin/exams.jsp|29" class="col-12"><button data-n11-src="admin/exams.jsp|30" class="btn btn-primary" type="submit">Tạo đề nháp</button></div></form></details><section data-n11-src="admin/exams.jsp|31" class="panel-card mb-4"><form data-n11-src="admin/exams.jsp|32" class="row g-3 align-items-end" method="get" action="${pageContext.request.contextPath}/admin/exams"><div data-n11-src="admin/exams.jsp|33" class="col-md-6"><label data-n11-src="admin/exams.jsp|34" class="form-label" for="exam-query">Tìm đề</label><input data-n11-src="admin/exams.jsp|35" id="exam-query" class="form-control" name="q" maxlength="220" value="${fn:escapeXml(q)}"/></div><div data-n11-src="admin/exams.jsp|36" class="col-md-3"><label data-n11-src="admin/exams.jsp|37" class="form-label" for="exam-status">Trạng thái</label><select data-n11-src="admin/exams.jsp|38" id="exam-status" class="form-select" name="status"><option value="all">Tất cả</option><option value="published" ${status eq 'published' ? 'selected' : ''}>Đã công bố</option><option value="draft" ${status eq 'draft' ? 'selected' : ''}>Đang ẩn</option></select></div><div data-n11-src="admin/exams.jsp|39" class="col-md-3"><button data-n11-src="admin/exams.jsp|40" class="btn btn-primary w-100">Lọc</button></div></form></section>
<section data-n11-src="admin/exams.jsp|41" class="panel-card"><h2 data-n11-src="admin/exams.jsp|42" class="account-section-title">Danh sách đề thi</h2><div data-n11-src="admin/exams.jsp|43" class="table-responsive"><table data-n11-src="admin/exams.jsp|44" class="table align-middle n11-exam-table"><thead data-n11-src="admin/exams.jsp|45"><tr data-n11-src="admin/exams.jsp|46"><th data-n11-src="admin/exams.jsp|47">Đề thi</th><th data-n11-src="admin/exams.jsp|48">Loại</th><th data-n11-src="admin/exams.jsp|49">Số câu</th><th data-n11-src="admin/exams.jsp|50">Thời gian</th><th data-n11-src="admin/exams.jsp|51">Lượt thi</th><th data-n11-src="admin/exams.jsp|52">Trạng thái</th><th data-n11-src="admin/exams.jsp|53">Thao tác</th></tr></thead><tbody data-n11-src="admin/exams.jsp|54">
<c:forEach items="${papers}" var="e"><tr data-n11-src="admin/exams.jsp|55"><td data-n11-src="admin/exams.jsp|56"><strong data-n11-src="admin/exams.jsp|57"><c:out value="${e.title}"/></strong><small data-n11-src="admin/exams.jsp|58" class="d-block small-meta">#${e.id}</small></td><td data-n11-src="admin/exams.jsp|59">${e.exam_type eq 'LR_FULL' ? 'Full Test' : 'Tùy chọn'}</td><td data-n11-src="admin/exams.jsp|60">${e.question_count}</td><td data-n11-src="admin/exams.jsp|61">${e.duration_minutes} phút</td><td data-n11-src="admin/exams.jsp|62">${e.attempt_count}</td><td data-n11-src="admin/exams.jsp|63"><span data-n11-src="admin/exams.jsp|64" class="badge-status ${e.is_published ? 'good' : 'muted'}">${e.is_published ? 'Công bố' : 'Đang ẩn'}</span></td><td data-n11-src="admin/exams.jsp|65"><a data-n11-src="admin/exams.jsp|66" class="btn btn-soft btn-sm" href="${pageContext.request.contextPath}/admin/exams/${e.id}">Quản lý</a></td></tr></c:forEach>
<c:if test="${empty papers}"><tr data-n11-src="admin/exams.jsp|67"><td data-n11-src="admin/exams.jsp|68" colspan="7" class="text-center py-4">Chưa có đề thi phù hợp.</td></tr></c:if></tbody></table></div></section>
</div></div></div></main>
<%@ include file="../fragments/scripts.jspf" %>
