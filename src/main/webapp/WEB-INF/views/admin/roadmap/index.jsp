<%@ page pageEncoding="UTF-8" %>
<%@ include file="../../fragments/head.jspf" %>
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/study-tracking.css"/>
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/admin-study-tracking.css?v=32.1"/>
<main data-n11-src="admin/roadmap/index.jsp|1" class="admin-shell n11-tracking"><div data-n11-src="admin/roadmap/index.jsp|2" class="container container-n11"><div data-n11-src="admin/roadmap/index.jsp|3" class="row g-4"><div data-n11-src="admin/roadmap/index.jsp|4" class="col-lg-3"><%@ include file="../../fragments/admin-sidebar.jspf" %></div><div data-n11-src="admin/roadmap/index.jsp|5" class="col-lg-9">
<section data-n11-src="admin/roadmap/index.jsp|6" class="reading-admin-hero n11-tracking-hero mb-4"><div data-n11-src="admin/roadmap/index.jsp|7"><h1 data-n11-src="admin/roadmap/index.jsp|8">Quản lý lộ trình học</h1><p data-n11-src="admin/roadmap/index.jsp|9">Giao kế hoạch học tập và theo dõi nhiệm vụ của học viên.</p></div></section>
<c:if test="${not empty successMessage}"><div data-n11-src="admin/roadmap/index.jsp|10" class="alert alert-success"><c:out value="${successMessage}"/></div></c:if><c:if test="${not empty errorMessage}"><div data-n11-src="admin/roadmap/index.jsp|11" class="alert alert-danger"><c:out value="${errorMessage}"/></div></c:if><section data-n11-src="admin/roadmap/index.jsp|12" class="panel-card mb-4"><h2 data-n11-src="admin/roadmap/index.jsp|13" class="account-section-title">Tạo lộ trình</h2><form data-n11-src="admin/roadmap/index.jsp|14" method="post" action="${pageContext.request.contextPath}/admin/roadmap" class="row g-3"><input data-n11-src="admin/roadmap/index.jsp|15" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><div data-n11-src="admin/roadmap/index.jsp|16" class="col-12"><label data-n11-src="admin/roadmap/index.jsp|17" class="form-label">Học viên</label><select data-n11-src="admin/roadmap/index.jsp|18" class="form-select" name="userId" required><option value="">Chọn học viên</option><c:forEach items="${students}" var="s"><option value="${s.id}"><c:out value="${s.full_name}"/> · <c:out value="${s.email}"/></option></c:forEach></select></div><div data-n11-src="admin/roadmap/index.jsp|19" class="col-md-6"><label data-n11-src="admin/roadmap/index.jsp|20" class="form-label">Tên lộ trình</label><input data-n11-src="admin/roadmap/index.jsp|21" class="form-control" name="title" maxlength="200" required placeholder="TOEIC 600"/></div><div data-n11-src="admin/roadmap/index.jsp|22" class="col-md-6"><label data-n11-src="admin/roadmap/index.jsp|23" class="form-label">Điểm mục tiêu TOEIC</label><input data-n11-src="admin/roadmap/index.jsp|24" class="form-control" type="number" min="10" max="990" step="5" name="score" required value="600"/></div><div data-n11-src="admin/roadmap/index.jsp|25" class="col-md-6"><label data-n11-src="admin/roadmap/index.jsp|26" class="form-label">Ngày bắt đầu</label><input data-n11-src="admin/roadmap/index.jsp|27" class="form-control" type="date" name="start" required value="${today}"/></div><div data-n11-src="admin/roadmap/index.jsp|28" class="col-md-6"><label data-n11-src="admin/roadmap/index.jsp|29" class="form-label">Ngày mục tiêu</label><input data-n11-src="admin/roadmap/index.jsp|30" class="form-control" type="date" name="end" required value="${endDate}"/></div><div data-n11-src="admin/roadmap/index.jsp|31" class="col-12"><button data-n11-src="admin/roadmap/index.jsp|32" class="btn btn-primary" type="submit">+ Tạo lộ trình</button></div></form></section>
<section data-n11-src="admin/roadmap/index.jsp|33" class="panel-card"><h2 data-n11-src="admin/roadmap/index.jsp|34" class="account-section-title">Danh sách lộ trình</h2><div data-n11-src="admin/roadmap/index.jsp|35" class="table-responsive"><table data-n11-src="admin/roadmap/index.jsp|36" class="table align-middle"><thead data-n11-src="admin/roadmap/index.jsp|37"><tr data-n11-src="admin/roadmap/index.jsp|38"><th data-n11-src="admin/roadmap/index.jsp|39">Học viên</th><th data-n11-src="admin/roadmap/index.jsp|40">Lộ trình</th><th data-n11-src="admin/roadmap/index.jsp|41">Mục tiêu</th><th data-n11-src="admin/roadmap/index.jsp|42">Nhiệm vụ</th><th data-n11-src="admin/roadmap/index.jsp|43">Trạng thái</th><th data-n11-src="admin/roadmap/index.jsp|44"></th></tr></thead><tbody data-n11-src="admin/roadmap/index.jsp|45"><c:forEach items="${plans}" var="p"><tr data-n11-src="admin/roadmap/index.jsp|46"><td data-n11-src="admin/roadmap/index.jsp|47"><c:out value="${p.full_name}"/></td><td data-n11-src="admin/roadmap/index.jsp|48"><c:out value="${p.title}"/></td><td data-n11-src="admin/roadmap/index.jsp|49">${p.target_score}</td><td data-n11-src="admin/roadmap/index.jsp|50">${p.done_count}/${p.item_count}</td><td data-n11-src="admin/roadmap/index.jsp|51"><c:choose><c:when test="${p.status eq 'ACTIVE'}">Đang học</c:when><c:when test="${p.status eq 'COMPLETED'}">Hoàn thành</c:when><c:otherwise>Lưu trữ</c:otherwise></c:choose></td><td data-n11-src="admin/roadmap/index.jsp|52"><a data-n11-src="admin/roadmap/index.jsp|53" class="btn btn-soft btn-sm" href="${pageContext.request.contextPath}/admin/roadmap/${p.id}">Quản lý</a></td></tr></c:forEach><c:if test="${empty plans}"><tr data-n11-src="admin/roadmap/index.jsp|54"><td data-n11-src="admin/roadmap/index.jsp|55" colspan="6" class="text-center py-4">Chưa có lộ trình.</td></tr></c:if></tbody></table></div></section></div></div></div></main>
<%@ include file="../../fragments/scripts.jspf" %>
