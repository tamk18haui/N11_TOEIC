<%@ page pageEncoding="UTF-8" %>
<%@ include file="../../fragments/head.jspf" %>
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/study-tracking.css"/>
<main data-n11-src="admin/roadmap/detail.jsp|1" class="admin-shell n11-tracking"><div data-n11-src="admin/roadmap/detail.jsp|2" class="container container-n11"><div data-n11-src="admin/roadmap/detail.jsp|3" class="row g-4"><div data-n11-src="admin/roadmap/detail.jsp|4" class="col-lg-3"><%@ include file="../../fragments/admin-sidebar.jspf" %></div><div data-n11-src="admin/roadmap/detail.jsp|5" class="col-lg-9">
<section data-n11-src="admin/roadmap/detail.jsp|6" class="reading-admin-hero mb-4"><div data-n11-src="admin/roadmap/detail.jsp|7"><h1 data-n11-src="admin/roadmap/detail.jsp|8">Chi tiết lộ trình</h1><p data-n11-src="admin/roadmap/detail.jsp|9">Điều chỉnh kế hoạch và học liệu được giao.</p></div></section>
<c:if test="${not empty successMessage}"><div data-n11-src="admin/roadmap/detail.jsp|10" class="alert alert-success"><c:out value="${successMessage}"/></div></c:if><c:if test="${not empty errorMessage}"><div data-n11-src="admin/roadmap/detail.jsp|11" class="alert alert-danger"><c:out value="${errorMessage}"/></div></c:if><a data-n11-src="admin/roadmap/detail.jsp|12" class="btn btn-soft mb-3" href="${pageContext.request.contextPath}/admin/roadmap">← Danh sách lộ trình</a><section data-n11-src="admin/roadmap/detail.jsp|13" class="panel-card mb-4"><h2 data-n11-src="admin/roadmap/detail.jsp|14" class="account-section-title"><c:out value="${plan.full_name}"/></h2><p data-n11-src="admin/roadmap/detail.jsp|15">Hoàn thành ${plan.done_count}/${plan.item_count} nhiệm vụ</p><form data-n11-src="admin/roadmap/detail.jsp|16" class="row g-3" method="post" action="${pageContext.request.contextPath}/admin/roadmap/${plan.id}/edit"><input data-n11-src="admin/roadmap/detail.jsp|17" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><div data-n11-src="admin/roadmap/detail.jsp|18" class="col-md-6"><label data-n11-src="admin/roadmap/detail.jsp|19" class="form-label">Tên lộ trình</label><input data-n11-src="admin/roadmap/detail.jsp|20" class="form-control" name="title" maxlength="200" required value="${fn:escapeXml(plan.title)}"/></div><div data-n11-src="admin/roadmap/detail.jsp|21" class="col-md-6"><label data-n11-src="admin/roadmap/detail.jsp|22" class="form-label">Điểm mục tiêu TOEIC</label><input data-n11-src="admin/roadmap/detail.jsp|23" class="form-control" type="number" min="10" max="990" step="5" name="score" required value="${plan.target_score}"/></div><div data-n11-src="admin/roadmap/detail.jsp|24" class="col-md-6"><label data-n11-src="admin/roadmap/detail.jsp|25" class="form-label">Ngày bắt đầu</label><input data-n11-src="admin/roadmap/detail.jsp|26" class="form-control" type="date" name="start" required value="${plan.start_date}"/></div><div data-n11-src="admin/roadmap/detail.jsp|27" class="col-md-6"><label data-n11-src="admin/roadmap/detail.jsp|28" class="form-label">Ngày mục tiêu</label><input data-n11-src="admin/roadmap/detail.jsp|29" class="form-control" type="date" name="end" required value="${plan.target_date}"/></div><div data-n11-src="admin/roadmap/detail.jsp|30" class="col-md-6"><label data-n11-src="admin/roadmap/detail.jsp|31" class="form-label">Trạng thái</label><select data-n11-src="admin/roadmap/detail.jsp|32" class="form-select" name="status"><option value="ACTIVE" ${plan.status eq 'ACTIVE' ? 'selected' : ''}>Đang học</option><option value="COMPLETED" ${plan.status eq 'COMPLETED' ? 'selected' : ''}>Hoàn thành</option><option value="ARCHIVED" ${plan.status eq 'ARCHIVED' ? 'selected' : ''}>Lưu trữ</option></select></div><div data-n11-src="admin/roadmap/detail.jsp|33" class="col-12"><button data-n11-src="admin/roadmap/detail.jsp|34" type="submit" class="btn btn-primary">Lưu lộ trình</button></div></form></section>
<c:if test="${plan.status eq 'ACTIVE'}"><section data-n11-src="admin/roadmap/detail.jsp|35" class="panel-card mb-4"><h2 data-n11-src="admin/roadmap/detail.jsp|36" class="account-section-title">Thêm nhiệm vụ</h2><form data-n11-src="admin/roadmap/detail.jsp|37" class="row g-3" method="post" action="${pageContext.request.contextPath}/admin/roadmap/${plan.id}/items"><input data-n11-src="admin/roadmap/detail.jsp|38" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><div data-n11-src="admin/roadmap/detail.jsp|39" class="col-12"><label data-n11-src="admin/roadmap/detail.jsp|40" class="form-label">Học liệu đã công bố</label><select data-n11-src="admin/roadmap/detail.jsp|41" class="form-select" name="choice" required><option value="">Chọn học liệu</option><c:forEach items="${catalog}" var="c"><option value="${c.type}:${c.id}"><c:out value="${c.category}"/> · <c:out value="${c.title}"/></option></c:forEach></select></div><div data-n11-src="admin/roadmap/detail.jsp|42" class="col-md-6"><label data-n11-src="admin/roadmap/detail.jsp|43" class="form-label">Thứ tự</label><input data-n11-src="admin/roadmap/detail.jsp|44" class="form-control" type="number" name="order" value="${(plan.item_count+1)*10}" min="0" max="100000" required/></div><div data-n11-src="admin/roadmap/detail.jsp|45" class="col-md-6"><label data-n11-src="admin/roadmap/detail.jsp|46" class="form-label">Hạn hoàn thành (không bắt buộc)</label><input data-n11-src="admin/roadmap/detail.jsp|47" class="form-control" type="date" name="due"/></div><div data-n11-src="admin/roadmap/detail.jsp|48" class="col-12"><button data-n11-src="admin/roadmap/detail.jsp|49" class="btn btn-primary" type="submit">+ Thêm nhiệm vụ</button></div></form></section></c:if>
<section data-n11-src="admin/roadmap/detail.jsp|50" class="panel-card"><h2 data-n11-src="admin/roadmap/detail.jsp|51" class="account-section-title">Nhiệm vụ đã giao</h2><div data-n11-src="admin/roadmap/detail.jsp|52" class="table-responsive"><table data-n11-src="admin/roadmap/detail.jsp|53" class="table align-middle"><thead data-n11-src="admin/roadmap/detail.jsp|54"><tr data-n11-src="admin/roadmap/detail.jsp|55"><th data-n11-src="admin/roadmap/detail.jsp|56">Học liệu</th><th data-n11-src="admin/roadmap/detail.jsp|57">Hạn</th><th data-n11-src="admin/roadmap/detail.jsp|58">Tiến độ tự đánh dấu</th><th data-n11-src="admin/roadmap/detail.jsp|59">Thứ tự</th><th data-n11-src="admin/roadmap/detail.jsp|60">Thao tác</th></tr></thead><tbody data-n11-src="admin/roadmap/detail.jsp|61"><c:forEach items="${items}" var="i"><tr data-n11-src="admin/roadmap/detail.jsp|62"><td data-n11-src="admin/roadmap/detail.jsp|63"><c:out value="${i.title}"/><c:if test="${not i.published}"><small data-n11-src="admin/roadmap/detail.jsp|64" class="d-block">Chưa công bố</small></c:if></td><td data-n11-src="admin/roadmap/detail.jsp|65"><c:out value="${i.due_date}" default="—"/></td><td data-n11-src="admin/roadmap/detail.jsp|66">${i.is_completed ? 'Đã hoàn thành' : 'Chưa hoàn thành'}</td><td data-n11-src="admin/roadmap/detail.jsp|67"><c:choose><c:when test="${plan.status eq 'ACTIVE'}"><form data-n11-src="admin/roadmap/detail.jsp|68" class="d-flex gap-1" method="post" action="${pageContext.request.contextPath}/admin/roadmap/${plan.id}/items/${i.id}/order"><input data-n11-src="admin/roadmap/detail.jsp|69" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><input data-n11-src="admin/roadmap/detail.jsp|70" class="form-control form-control-sm n11-order" type="number" name="order" value="${i.item_order}" min="0" max="100000" required/><button data-n11-src="admin/roadmap/detail.jsp|71" class="btn btn-soft btn-sm">Lưu</button></form></c:when><c:otherwise>${i.item_order}</c:otherwise></c:choose></td><td data-n11-src="admin/roadmap/detail.jsp|72"><c:if test="${plan.status eq 'ACTIVE' and not i.is_completed}"><form data-n11-src="admin/roadmap/detail.jsp|73" method="post" action="${pageContext.request.contextPath}/admin/roadmap/${plan.id}/items/${i.id}/remove" onsubmit="return confirm('Bỏ nhiệm vụ này?')"><input data-n11-src="admin/roadmap/detail.jsp|74" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><button data-n11-src="admin/roadmap/detail.jsp|75" class="btn btn-outline-danger btn-sm">Bỏ</button></form></c:if></td></tr></c:forEach><c:if test="${empty items}"><tr data-n11-src="admin/roadmap/detail.jsp|76"><td data-n11-src="admin/roadmap/detail.jsp|77" colspan="5" class="text-center py-4">Chưa giao nhiệm vụ.</td></tr></c:if></tbody></table></div></section></div></div></div></main>
<%@ include file="../../fragments/scripts.jspf" %>
