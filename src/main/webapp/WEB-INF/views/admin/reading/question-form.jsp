<%-- N11 SOURCE NOTES V24: JSP dựng bố cục và hiển thị dữ liệu từ Controller. class="..." nối CSS; form action/method xác định endpoint và phương thức gửi. c:forEach lặp dữ liệu; c:if kiểm tra điều kiện; c:out hiển thị văn bản an toàn. Không đặt nghiệp vụ ở JSP. --%>
<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ include file="../../fragments/head.jspf" %>
<main data-n11-src="admin/reading/question-form.jsp|1" class="admin-shell admin-reading-page"><div data-n11-src="admin/reading/question-form.jsp|2" class="container container-n11"><div data-n11-src="admin/reading/question-form.jsp|3" class="row g-4">
<div data-n11-src="admin/reading/question-form.jsp|4" class="col-lg-3"><%@ include file="../../fragments/admin-sidebar.jspf" %></div><div data-n11-src="admin/reading/question-form.jsp|5" class="col-lg-9">
 <a data-n11-src="admin/reading/question-form.jsp|6" class="account-back" href="${pageContext.request.contextPath}/admin/reading/sets/${set.id}">← Bộ Reading</a><h1 data-n11-src="admin/reading/question-form.jsp|7" class="account-title mt-2">${empty question.id ? 'Thêm câu hỏi' : 'Chỉnh sửa câu hỏi'} · Part ${set.part_no}</h1>
 <c:if test="${not empty errorMessage}"><div data-n11-src="admin/reading/question-form.jsp|8" class="alert alert-danger"><c:out value="${errorMessage}"/></div></c:if>
 <%-- Khối nội dung: CSS panel-card điều chỉnh nền, viền và khoảng cách. --%><section data-n11-src="admin/reading/question-form.jsp|9" class="panel-card"><form data-n11-src="admin/reading/question-form.jsp|10" action="${pageContext.request.contextPath}/admin/reading/sets/${set.id}/questions/save" method="post" class="row g-3">
  <%-- CSRF token bảo vệ yêu cầu POST. --%><input data-n11-src="admin/reading/question-form.jsp|11" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/>
  <c:if test="${not empty question.id}"><input data-n11-src="admin/reading/question-form.jsp|12" type="hidden" name="questionId" value="${question.id}"/></c:if>
  <c:if test="${set.part_no ne 5}"><div data-n11-src="admin/reading/question-form.jsp|13" class="col-md-8"><label data-n11-src="admin/reading/question-form.jsp|14" class="form-label" for="passageId">Đoạn đọc</label><select data-n11-src="admin/reading/question-form.jsp|15" class="form-select" name="passageId" id="passageId" required>
   <option value="">Chọn đoạn</option><c:forEach items="${passages}" var="p"><option value="${p.id}" ${question.passage_id eq p.id ? 'selected' : ''}><c:out value="${p.title}"/></option></c:forEach></select></div></c:if>
  <div data-n11-src="admin/reading/question-form.jsp|16" class="col-md-4"><label data-n11-src="admin/reading/question-form.jsp|17" class="form-label" for="sortOrder">Thứ tự</label><input data-n11-src="admin/reading/question-form.jsp|18" type="number" min="0" id="sortOrder" class="form-control" name="sortOrder" value="${question.sort_order}"/></div>
  <div data-n11-src="admin/reading/question-form.jsp|19" class="col-md-4"><label data-n11-src="admin/reading/question-form.jsp|20" for="questionLevel" class="form-label">Cấp độ</label><%-- Trường cấp độ câu hỏi: value là cấp gửi đến Controller. --%><select data-n11-src="admin/reading/question-form.jsp|21" name="questionLevel" id="questionLevel" class="form-select"><option value="0" ${set.level eq 0 ? 'selected' : ''}>Chưa phân loại</option><option value="1" ${set.level eq 1 ? 'selected' : ''}>1 · Rất dễ</option><option value="2" ${set.level eq 2 ? 'selected' : ''}>2 · Dễ</option><option value="3" ${set.level eq 3 ? 'selected' : ''}>3 · Trung bình</option><option value="4" ${set.level eq 4 ? 'selected' : ''}>4 · Khó</option><option value="5" ${set.level eq 5 ? 'selected' : ''}>5 · Rất khó</option></select><c:if test="${set.part_no ne 5}"><small data-n11-src="admin/reading/question-form.jsp|22" class="form-text">Đổi cấp áp dụng cho cả đoạn.</small></c:if></div>
    <div data-n11-src="admin/reading/question-form.jsp|23" class="col-12"><label data-n11-src="admin/reading/question-form.jsp|24" class="form-label" for="questionText">Nội dung câu hỏi</label><textarea data-n11-src="admin/reading/question-form.jsp|25" class="form-control" name="questionText" id="questionText" rows="3" required><c:out value="${question.question_text}"/></textarea></div>
  <div data-n11-src="admin/reading/question-form.jsp|26" class="col-md-6"><label data-n11-src="admin/reading/question-form.jsp|27" class="form-label">Đáp án A</label><textarea data-n11-src="admin/reading/question-form.jsp|28" name="optionA" class="form-control" rows="2" required><c:out value="${question.optionA}"/></textarea></div>
  <div data-n11-src="admin/reading/question-form.jsp|29" class="col-md-6"><label data-n11-src="admin/reading/question-form.jsp|30" class="form-label">Đáp án B</label><textarea data-n11-src="admin/reading/question-form.jsp|31" name="optionB" class="form-control" rows="2" required><c:out value="${question.optionB}"/></textarea></div>
  <div data-n11-src="admin/reading/question-form.jsp|32" class="col-md-6"><label data-n11-src="admin/reading/question-form.jsp|33" class="form-label">Đáp án C</label><textarea data-n11-src="admin/reading/question-form.jsp|34" name="optionC" class="form-control" rows="2" required><c:out value="${question.optionC}"/></textarea></div>
  <div data-n11-src="admin/reading/question-form.jsp|35" class="col-md-6"><label data-n11-src="admin/reading/question-form.jsp|36" class="form-label">Đáp án D</label><textarea data-n11-src="admin/reading/question-form.jsp|37" name="optionD" class="form-control" rows="2" required><c:out value="${question.optionD}"/></textarea></div>
  <div data-n11-src="admin/reading/question-form.jsp|38" class="col-md-4"><label data-n11-src="admin/reading/question-form.jsp|39" class="form-label" for="correctLabel">Đáp án đúng</label><select data-n11-src="admin/reading/question-form.jsp|40" id="correctLabel" class="form-select" name="correctLabel" required>
   <option value="">Chọn đáp án</option><option value="A" ${question.correctLabel eq 'A' ? 'selected' : ''}>A</option><option value="B" ${question.correctLabel eq 'B' ? 'selected' : ''}>B</option><option value="C" ${question.correctLabel eq 'C' ? 'selected' : ''}>C</option><option value="D" ${question.correctLabel eq 'D' ? 'selected' : ''}>D</option></select></div>
  <div data-n11-src="admin/reading/question-form.jsp|41" class="col-12"><label data-n11-src="admin/reading/question-form.jsp|42" class="form-label" for="explanation">Giải thích</label><textarea data-n11-src="admin/reading/question-form.jsp|43" class="form-control" name="explanation" id="explanation" rows="3"><c:out value="${question.explanation}"/></textarea></div>
  <div data-n11-src="admin/reading/question-form.jsp|44" class="col-12"><button data-n11-src="admin/reading/question-form.jsp|45" class="btn btn-primary" type="submit">Lưu câu hỏi</button></div>
 </form></section>
</div></div></div></main>
<%@ include file="../../fragments/scripts.jspf" %>
