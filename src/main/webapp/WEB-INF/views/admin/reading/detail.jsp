<%-- N11 SOURCE NOTES V24: JSP dựng bố cục và hiển thị dữ liệu từ Controller. class="..." nối CSS; form action/method xác định endpoint và phương thức gửi. c:forEach lặp dữ liệu; c:if kiểm tra điều kiện; c:out hiển thị văn bản an toàn. Không đặt nghiệp vụ ở JSP. --%>
<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ include file="../../fragments/head.jspf" %>
<main data-n11-src="admin/reading/detail.jsp|1" class="admin-shell admin-reading-page" data-reading-admin data-base="${pageContext.request.contextPath}"><div data-n11-src="admin/reading/detail.jsp|2" class="container container-n11"><div data-n11-src="admin/reading/detail.jsp|3" class="row g-4">
<div data-n11-src="admin/reading/detail.jsp|4" class="col-lg-3"><%@ include file="../../fragments/admin-sidebar.jspf" %></div>
<div data-n11-src="admin/reading/detail.jsp|5" class="col-lg-9">
 <a data-n11-src="admin/reading/detail.jsp|6" class="account-back" href="${pageContext.request.contextPath}/admin/reading">← Quản lý Reading</a>
 <header data-n11-src="admin/reading/detail.jsp|7" class="reading-admin-hero mt-3"><div data-n11-src="admin/reading/detail.jsp|8"><span data-n11-src="admin/reading/detail.jsp|9" class="section-caption">READING · PART ${set.part_no} · CẤP ${set.level}</span><h1 data-n11-src="admin/reading/detail.jsp|10"><c:out value="${set.title}"/></h1><p data-n11-src="admin/reading/detail.jsp|11">${set.question_count} câu · ${set.attempt_count} lượt làm bài</p></div>
 <a data-n11-src="admin/reading/detail.jsp|12" href="${pageContext.request.contextPath}/admin/reading/sets/${set.id}/edit" class="btn btn-soft">Sửa thông tin</a></header>
 <div data-n11-src="admin/reading/detail.jsp|13" id="readingAjaxMessage" role="status" aria-live="polite" hidden></div>
 <c:if test="${not empty successMessage}"><div data-n11-src="admin/reading/detail.jsp|14" class="alert alert-success"><c:out value="${successMessage}"/></div></c:if>
  <c:if test="${not empty levelSuccessMessage}"><div data-n11-src="admin/reading/detail.jsp|15" class="n11-level-feedback" role="status"><c:out value="${levelSuccessMessage}"/></div></c:if>
 <c:if test="${not empty errorMessage}"><div data-n11-src="admin/reading/detail.jsp|16" class="alert alert-danger"><c:out value="${errorMessage}"/></div></c:if>
 <section data-n11-src="admin/reading/detail.jsp|17" class="panel-card mb-4"><div data-n11-src="admin/reading/detail.jsp|18" class="d-flex justify-content-between align-items-center flex-wrap gap-3">
  <div data-n11-src="admin/reading/detail.jsp|19"><strong data-n11-src="admin/reading/detail.jsp|20">Trạng thái:</strong> <span data-n11-src="admin/reading/detail.jsp|21" data-publication-label class="badge-status ${set.is_published ? 'good' : 'warn'}">${set.is_published ? 'Đã công bố' : 'Bản nháp'}</span>
   <c:if test="${set.attempt_count gt 0}"><p data-n11-src="admin/reading/detail.jsp|22" class="small-meta mt-2 mb-0">Đã có lượt làm. Không thể chỉnh sửa nội dung.</p></c:if></div>
  <div data-n11-src="admin/reading/detail.jsp|23" class="reading-actions">
  <form data-n11-src="admin/reading/detail.jsp|24" action="${pageContext.request.contextPath}/admin/reading/sets/${set.id}/publish" method="post" data-ajax-publication data-set-id="${set.id}"><%-- CSRF token bảo vệ yêu cầu POST. --%><input data-n11-src="admin/reading/detail.jsp|25" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><input data-n11-src="admin/reading/detail.jsp|26" type="hidden" name="published" value="${set.is_published ? 'false' : 'true'}"/><button data-n11-src="admin/reading/detail.jsp|27" class="btn btn-primary" type="submit">${set.is_published ? 'Ẩn bộ Reading' : 'Công bố cho học viên'}</button></form>
  <form data-n11-src="admin/reading/detail.jsp|28" action="${pageContext.request.contextPath}/admin/reading/sets/${set.id}/delete" method="post" onsubmit="return confirm('Chỉ xóa được bộ nháp trống. Xóa bộ này?')"><input data-n11-src="admin/reading/detail.jsp|29" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><button data-n11-src="admin/reading/detail.jsp|30" class="btn btn-soft" type="submit">Xóa bộ trống</button></form></div>
  </div></section>
 <div data-n11-src="admin/reading/detail.jsp|31" class="n11-level-panel"><span data-n11-src="admin/reading/detail.jsp|32" class="n11-level-caption">Cấp độ</span><%-- Nút cấp độ: summary mở menu; select chọn cấp; form POST gửi lựa chọn lên Controller. --%><details data-n11-src="admin/reading/detail.jsp|33" class="n11-level-compact"><summary data-n11-src="admin/reading/detail.jsp|34" title="Đổi cấp độ bộ luyện" aria-label="Đổi cấp độ bộ luyện"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 17h16"/><circle cx="9" cy="7" r="2.5" fill="white"/><circle cx="15" cy="17" r="2.5" fill="white"/></svg><span data-n11-src="admin/reading/detail.jsp|35"><c:choose><c:when test="${set.level eq 1}">Cấp 1</c:when><c:when test="${set.level eq 2}">Cấp 2</c:when><c:when test="${set.level eq 3}">Cấp 3</c:when><c:when test="${set.level eq 4}">Cấp 4</c:when><c:when test="${set.level eq 5}">Cấp 5</c:when><c:otherwise>Chưa gán</c:otherwise></c:choose></span></summary><div data-n11-src="admin/reading/detail.jsp|36" class="n11-level-menu"><form data-n11-src="admin/reading/detail.jsp|37" class="n11-level-form" method="post" action="${pageContext.request.contextPath}/admin/practice-levels/reading/${set.id}">
<input data-n11-src="admin/reading/detail.jsp|38" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><input data-n11-src="admin/reading/detail.jsp|39" type="hidden" name="back" value="detail"/>
<select data-n11-src="admin/reading/detail.jsp|40" class="form-select" name="level" aria-label="Cấp độ bộ luyện"><option value="0" ${set.level eq 0 ? 'selected' : ''}>Chưa gán</option><option value="1" ${set.level eq 1 ? 'selected' : ''}>1 · Rất dễ</option><option value="2" ${set.level eq 2 ? 'selected' : ''}>2 · Dễ</option><option value="3" ${set.level eq 3 ? 'selected' : ''}>3 · Trung bình</option><option value="4" ${set.level eq 4 ? 'selected' : ''}>4 · Khó</option><option value="5" ${set.level eq 5 ? 'selected' : ''}>5 · Rất khó</option></select>
<button data-n11-src="admin/reading/detail.jsp|41" class="btn btn-soft btn-sm" name="mode" value="manual" type="submit">Lưu cấp</button><button data-n11-src="admin/reading/detail.jsp|42" class="btn btn-sm n11-level-random" name="mode" value="random" type="submit" onclick="return confirm('Gán cấp độ ngẫu nhiên?')">Random</button></form></div></details>
</div>
<c:if test="${set.part_no ne 5}"><section data-n11-src="admin/reading/detail.jsp|43" class="panel-card mb-4">
  <div data-n11-src="admin/reading/detail.jsp|44" class="d-flex justify-content-between align-items-center mb-3"><h2 data-n11-src="admin/reading/detail.jsp|45" class="account-section-title mb-0">Các đoạn đọc</h2><span data-n11-src="admin/reading/detail.jsp|46" class="small-meta">Part ${set.part_no} · ${set.part_no eq 6 ? '4 câu mỗi đoạn' : '2–5 câu mỗi đoạn'}</span></div>
  <c:forEach items="${passages}" var="p"><details data-n11-src="admin/reading/detail.jsp|47" class="reading-admin-item"><summary data-n11-src="admin/reading/detail.jsp|48"><strong data-n11-src="admin/reading/detail.jsp|49"><c:out value="${p.title}"/></strong> · Mã đoạn #${p.id}</summary>
    <form data-n11-src="admin/reading/detail.jsp|50" action="${pageContext.request.contextPath}/admin/reading/sets/${set.id}/passages/save" method="post" class="row g-2 mt-3"><input data-n11-src="admin/reading/detail.jsp|51" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><input data-n11-src="admin/reading/detail.jsp|52" type="hidden" name="passageId" value="${p.id}"/>
     <div data-n11-src="admin/reading/detail.jsp|53" class="col-12"><label data-n11-src="admin/reading/detail.jsp|54" class="form-label">Tiêu đề</label><input data-n11-src="admin/reading/detail.jsp|55" class="form-control" name="title" required maxlength="200" value="<c:out value='${p.title}'/>"/></div>
     <div data-n11-src="admin/reading/detail.jsp|56" class="col-12"><label data-n11-src="admin/reading/detail.jsp|57" class="form-label">Bài đọc (mỗi dòng là một đoạn)</label><textarea data-n11-src="admin/reading/detail.jsp|58" class="form-control" name="body" rows="5" required><c:out value="${p.body}"/></textarea></div>
     <div data-n11-src="admin/reading/detail.jsp|59" class="col-md-5"><label data-n11-src="admin/reading/detail.jsp|60" class="form-label">Thứ tự</label><input data-n11-src="admin/reading/detail.jsp|61" class="form-control" type="number" name="sortOrder" min="0" value="${p.sort_order}"/></div>
     <div data-n11-src="admin/reading/detail.jsp|62" class="col-12"><button data-n11-src="admin/reading/detail.jsp|63" type="submit" class="btn btn-primary btn-sm">Lưu đoạn</button></div></form>
    <form data-n11-src="admin/reading/detail.jsp|64" action="${pageContext.request.contextPath}/admin/reading/sets/${set.id}/passages/${p.id}/delete" method="post" onsubmit="return confirm('Xóa đoạn đọc này?')" class="mt-2"><input data-n11-src="admin/reading/detail.jsp|65" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><button data-n11-src="admin/reading/detail.jsp|66" class="btn btn-outline-primary btn-sm" type="submit">Xóa đoạn</button></form>
   </details></c:forEach>
  <details data-n11-src="admin/reading/detail.jsp|67" class="reading-admin-item"><summary data-n11-src="admin/reading/detail.jsp|68"><strong data-n11-src="admin/reading/detail.jsp|69">+ Thêm đoạn đọc</strong></summary>
   <form data-n11-src="admin/reading/detail.jsp|70" action="${pageContext.request.contextPath}/admin/reading/sets/${set.id}/passages/save" method="post" class="row g-3 mt-2"><input data-n11-src="admin/reading/detail.jsp|71" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/>
    <div data-n11-src="admin/reading/detail.jsp|72" class="col-12"><label data-n11-src="admin/reading/detail.jsp|73" class="form-label">Tiêu đề</label><input data-n11-src="admin/reading/detail.jsp|74" class="form-control" name="title" required maxlength="200"/></div>
    <div data-n11-src="admin/reading/detail.jsp|75" class="col-12"><label data-n11-src="admin/reading/detail.jsp|76" class="form-label">Nội dung tiếng Anh (mỗi đoạn một dòng)</label><textarea data-n11-src="admin/reading/detail.jsp|77" class="form-control" name="body" rows="6" required></textarea></div>
    <div data-n11-src="admin/reading/detail.jsp|78" class="col-md-4"><label data-n11-src="admin/reading/detail.jsp|79" class="form-label">Thứ tự</label><input data-n11-src="admin/reading/detail.jsp|80" class="form-control" type="number" name="sortOrder" min="0" value="0"/></div>
    <div data-n11-src="admin/reading/detail.jsp|81" class="col-12"><button data-n11-src="admin/reading/detail.jsp|82" class="btn btn-primary" type="submit">Thêm đoạn</button></div>
   </form></details>
  
 </section></c:if>
 <%-- Khối nội dung: CSS panel-card điều chỉnh nền, viền và khoảng cách. --%><section data-n11-src="admin/reading/detail.jsp|83" class="panel-card"><div data-n11-src="admin/reading/detail.jsp|84" class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-3"><h2 data-n11-src="admin/reading/detail.jsp|85" class="account-section-title mb-0">Câu hỏi và đáp án</h2><a data-n11-src="admin/reading/detail.jsp|86" class="btn btn-primary" href="${pageContext.request.contextPath}/admin/reading/sets/${set.id}/questions/new">+ Thêm câu hỏi</a></div>
 <%-- Bảng danh sách: thead là tiêu đề, tbody chứa các bản ghi từ Controller. --%><div data-n11-src="admin/reading/detail.jsp|87" class="admin-table-wrap"><table data-n11-src="admin/reading/detail.jsp|88" class="table align-middle reading-admin-table"><thead data-n11-src="admin/reading/detail.jsp|89"><tr data-n11-src="admin/reading/detail.jsp|90"><th data-n11-src="admin/reading/detail.jsp|91">Thứ tự</th><th data-n11-src="admin/reading/detail.jsp|92">Câu hỏi</th><th data-n11-src="admin/reading/detail.jsp|93">Đoạn</th><th data-n11-src="admin/reading/detail.jsp|94">Đúng</th><th data-n11-src="admin/reading/detail.jsp|95">Thao tác</th></tr></thead><tbody data-n11-src="admin/reading/detail.jsp|96">
  <c:forEach items="${questions}" var="q"><tr data-n11-src="admin/reading/detail.jsp|97"><td data-n11-src="admin/reading/detail.jsp|98">${q.sort_order}</td><td data-n11-src="admin/reading/detail.jsp|99"><c:out value="${q.question_text}"/></td><td data-n11-src="admin/reading/detail.jsp|100">${empty q.passage_id ? '—' : q.passage_id}</td><td data-n11-src="admin/reading/detail.jsp|101"><c:out value="${q.correct_label}"/></td><td data-n11-src="admin/reading/detail.jsp|102" class="reading-actions">
   <a data-n11-src="admin/reading/detail.jsp|103" class="btn btn-soft btn-sm" href="${pageContext.request.contextPath}/admin/reading/sets/${set.id}/questions/${q.id}/edit">Sửa</a>
   <form data-n11-src="admin/reading/detail.jsp|104" action="${pageContext.request.contextPath}/admin/reading/sets/${set.id}/questions/${q.id}/delete" method="post" onsubmit="return confirm('Xóa câu hỏi này?')"><input data-n11-src="admin/reading/detail.jsp|105" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><button data-n11-src="admin/reading/detail.jsp|106" class="btn btn-outline-primary btn-sm" type="submit">Xóa</button></form>
  </td></tr></c:forEach>
  <c:if test="${empty questions}"><tr data-n11-src="admin/reading/detail.jsp|107"><td data-n11-src="admin/reading/detail.jsp|108" colspan="5" class="py-4 text-center">Chưa có câu hỏi trong bộ Reading.</td></tr></c:if>
 </tbody></table></div></section>
 </div></div></div></main>
<script defer src="${pageContext.request.contextPath}/assets/js/admin-reading-ajax-v18.js?v=18"></script>
<%@ include file="../../fragments/scripts.jspf" %>
