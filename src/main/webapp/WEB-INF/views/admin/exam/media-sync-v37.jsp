<%@ page pageEncoding="UTF-8" %>
<%@ include file="../../fragments/head.jspf" %>
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/admin-exams-v33.css"/>
<c:if test="${sync.running()}"><script>setTimeout(()=>location.reload(),4000);</script></c:if>
<main class="admin-shell n11-admin-content n11-exam-admin"><div class="container container-n11"><div class="row g-4"><div class="col-lg-3"><%@ include file="../../fragments/admin-sidebar.jspf" %></div><div class="col-lg-9 n11-content-main">
<header class="n11-content-hero"><div><h1 class="account-title">Đồng bộ media Cloudinary</h1><p class="small-meta">Dùng chung audio và hình ảnh giữa các thành viên.</p></div><a class="btn btn-soft" href="${pageContext.request.contextPath}/admin/exams/offline">← Nguồn học liệu</a></header>
<c:if test="${not empty errorMessage}"><div class="alert alert-danger"><c:out value="${errorMessage}"/></div></c:if>
<section class="panel-card mb-3"><h2 class="account-section-title">Tình trạng tài nguyên</h2><p class="small-meta">Thư mục: <code><c:out value="${directory}"/></code></p><div class="row g-3"><div class="col-6 col-md-3"><div class="border rounded p-3"><small>Local</small><h3>${scan.local()}</h3></div></div><div class="col-6 col-md-3"><div class="border rounded p-3"><small>Sẵn sàng</small><h3>${scan.ready()}</h3></div></div><div class="col-6 col-md-3"><div class="border rounded p-3"><small>Cloudinary (URL)</small><h3>${scan.cloud()}</h3></div></div><div class="col-6 col-md-3"><div class="border rounded p-3"><small>URL khác</small><h3>${scan.other()}</h3></div></div></div><p class="mt-3">Dung lượng Local sẵn sàng (mỗi URL một lần): ${scan.bytes()} bytes.</p><p>Media mới: <strong><c:out value="${mode}"/></strong> · Cloudinary: <strong>${cloudReady ? 'Đã cấu hình' : 'Chưa bật / thiếu khóa'}</strong></p><c:if test="${not cloudReady}"><p class="alert alert-warning">Kiểm tra .env.cloudinary trên máy chủ và CLOUDINARY_ENABLED=true. Không nhập khóa vào website.</p></c:if><div class="d-flex flex-wrap gap-2"><a class="btn btn-soft" href="${pageContext.request.contextPath}/admin/exams/offline/media-sync">Quét lại</a><a class="btn btn-soft" href="${pageContext.request.contextPath}/admin/exams/offline">Chọn Cloudinary cho upload mới</a></div></section>
<section class="panel-card mb-3"><h2 class="account-section-title">Đồng bộ các URL Local</h2><p>Giữ nguyên ID và file gốc. Chỉ cập nhật URL nếu CDN phản hồi công khai. Chạy lại để xử lý phần còn thiếu.</p><form method="post" action="${pageContext.request.contextPath}/admin/exams/offline/media-sync/apply"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><label class="d-flex align-items-start gap-2 mb-3"><input type="checkbox" name="confirmed" value="true" required/> Tôi đã sao lưu MySQL, có quyền đưa học liệu lên cloud và đồng ý với chi phí/băng thông phát sinh.</label><button type="submit" class="btn btn-primary" ${sync.running() or not cloudReady or scan.ready() eq 0 ? 'disabled' : ''}>Đồng bộ Local lên Cloudinary</button></form><p class="mt-3"><c:out value="${sync.message()}"/> · ${sync.done()}/${sync.total()} · Thành công ${sync.success()} · Lỗi ${sync.failed()}</p><div class="progress mb-3" role="progressbar" aria-label="Tiến độ"><div class="progress-bar" style="width:${sync.total() eq 0 ? 0 : sync.done()*100/sync.total()}%"></div></div><div style="max-height:260px;overflow:auto"><c:forEach items="${sync.log()}" var="line"><div><c:out value="${line}"/></div></c:forEach></div></section>
<section class="panel-card"><h2 class="account-section-title">Media Local còn lại</h2><div class="table-responsive" style="max-height:420px;overflow:auto"><table class="table align-middle"><thead><tr><th>ID</th><th>Loại</th><th>Đường dẫn</th><th>Trạng thái</th></tr></thead><tbody><c:forEach items="${scan.items()}" var="item"><tr><td>${item.id()}</td><td><c:out value="${item.type()}"/></td><td style="overflow-wrap:anywhere"><c:out value="${item.url()}"/></td><td><c:out value="${item.state()}"/></td></tr></c:forEach><c:if test="${empty scan.items()}"><tr><td colspan="4">Không còn URL /listening-media/ trong MySQL.</td></tr></c:if></tbody></table></div><p class="small-meta">Nhật ký URL cũ/mới: .local/n11-media-sync-v37.tsv. Các URL cloud đã có chỉ được đếm, chưa kiểm tra lại khả năng phát.</p></section>
</div></div></div></main><%@ include file="../../fragments/scripts.jspf" %>
