<%@ page pageEncoding="UTF-8" %>
<%@ include file="../../fragments/head.jspf" %>
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/admin-exams-v33.css"/>
<main data-n11-src="admin/exam/preview.jsp|1" class="admin-shell n11-admin-content n11-exam-admin"><div data-n11-src="admin/exam/preview.jsp|2" class="container container-n11"><div data-n11-src="admin/exam/preview.jsp|3" class="row g-4">
<div data-n11-src="admin/exam/preview.jsp|4" class="col-lg-3"><%@ include file="../../fragments/admin-sidebar.jspf" %></div><div data-n11-src="admin/exam/preview.jsp|5" class="col-lg-9 n11-content-main">
<header data-n11-src="admin/exam/preview.jsp|6" class="n11-content-hero"><div data-n11-src="admin/exam/preview.jsp|7"><div data-n11-src="admin/exam/preview.jsp|8" class="section-caption">QUẢN LÝ ĐỀ THI</div><h1 data-n11-src="admin/exam/preview.jsp|9" class="account-title">Xem trước đề thi</h1><p data-n11-src="admin/exam/preview.jsp|10" class="small-meta mb-0"><c:out value="${paper.title}"/> · Chỉ Admin</p></div><a data-n11-src="admin/exam/preview.jsp|11" class="btn btn-soft" href="${pageContext.request.contextPath}/admin/exams/${paper.id}">← Quản lý đề</a></header><c:if test="${empty questions}"><section data-n11-src="admin/exam/preview.jsp|12" class="panel-card">Đề chưa có câu hỏi.</section></c:if>
<c:forEach items="${questions}" var="q"><section data-n11-src="admin/exam/preview.jsp|13" class="panel-card mb-3"><h2 data-n11-src="admin/exam/preview.jsp|14" class="account-section-title">Câu ${q.number} · Part ${q.part_no}</h2><c:if test="${not empty q.passage_text}"><details data-n11-src="admin/exam/preview.jsp|15" class="mb-3"><summary data-n11-src="admin/exam/preview.jsp|16">Đoạn văn / transcript</summary><p data-n11-src="admin/exam/preview.jsp|17" class="n11-exam-passage"><c:out value="${q.passage_text}"/></p></details></c:if>
<c:if test="${not empty q.image_url}"><img data-n11-src="admin/exam/preview.jsp|18" class="n11-exam-media" alt="Hình câu hỏi" src="${fn:startsWith(q.image_url,'/') ? pageContext.request.contextPath : ''}${fn:escapeXml(q.image_url)}" loading="lazy"/></c:if><c:if test="${not empty q.audio_url}"><audio data-n11-src="admin/exam/preview.jsp|19" class="n11-exam-audio" controls preload="none" src="${fn:startsWith(q.audio_url,'/') ? pageContext.request.contextPath : ''}${fn:escapeXml(q.audio_url)}"></audio></c:if><p data-n11-src="admin/exam/preview.jsp|20" class="n11-exam-passage"><c:out value="${q.question_text}"/></p><c:forEach items="${q.options}" var="o"><div data-n11-src="admin/exam/preview.jsp|21" class="n11-exam-option ${o.is_correct ? 'is-correct' : ''}"><strong data-n11-src="admin/exam/preview.jsp|22"><c:out value="${o.option_label}"/>.</strong> <c:out value="${o.option_text}"/><c:if test="${o.is_correct}"> <small data-n11-src="admin/exam/preview.jsp|23">✓ Đáp án đúng</small></c:if></div></c:forEach><c:if test="${not empty q.explanation}"><details class="mt-3"><summary>Giải thích / transcript</summary><p class="n11-exam-passage"><c:out value="${q.explanation}"/></p></details></c:if></section></c:forEach>
</div></div></div></main>
<%@ include file="../../fragments/scripts.jspf" %>
