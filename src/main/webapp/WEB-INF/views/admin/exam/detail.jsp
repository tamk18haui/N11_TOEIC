<%@ page pageEncoding="UTF-8" %>
<%@ include file="../../fragments/head.jspf" %>
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/admin-exams-v33.css"/>
<main data-n11-src="admin/exam/detail.jsp|1" class="admin-shell n11-admin-content n11-exam-admin"><div data-n11-src="admin/exam/detail.jsp|2" class="container container-n11"><div data-n11-src="admin/exam/detail.jsp|3" class="row g-4">
<div data-n11-src="admin/exam/detail.jsp|4" class="col-lg-3"><%@ include file="../../fragments/admin-sidebar.jspf" %></div><div data-n11-src="admin/exam/detail.jsp|5" class="col-lg-9 n11-content-main">
<header data-n11-src="admin/exam/detail.jsp|6" class="n11-content-hero"><div data-n11-src="admin/exam/detail.jsp|7"><div data-n11-src="admin/exam/detail.jsp|8" class="section-caption">QUẢN LÝ ĐỀ THI</div><h1 data-n11-src="admin/exam/detail.jsp|9" class="account-title"><c:out value="${paper.title}"/></h1><p data-n11-src="admin/exam/detail.jsp|10" class="small-meta mb-0">${paper.question_count} câu · ${paper.duration_minutes} phút · ${paper.attempt_count} lượt thi</p></div><a data-n11-src="admin/exam/detail.jsp|11" href="${pageContext.request.contextPath}/admin/exams" class="btn btn-soft">← Danh sách đề</a></header><c:if test="${not empty successMessage}"><div data-n11-src="admin/exam/detail.jsp|12" class="alert alert-success" role="status"><c:out value="${successMessage}"/></div></c:if>
<c:if test="${not empty errorMessage}"><div data-n11-src="admin/exam/detail.jsp|13" class="alert alert-danger" role="alert"><c:out value="${errorMessage}"/></div></c:if><section data-n11-src="admin/exam/detail.jsp|14" class="panel-card mb-4"><div data-n11-src="admin/exam/detail.jsp|15" class="d-flex flex-wrap gap-2 align-items-center"><span data-n11-src="admin/exam/detail.jsp|16" class="badge-status ${paper.is_published ? 'good' : 'muted'}">${paper.is_published ? 'Đã công bố' : 'Đang ẩn'}</span><a data-n11-src="admin/exam/detail.jsp|17" class="btn btn-soft" href="${pageContext.request.contextPath}/admin/exams/${paper.id}/preview">Xem trước đề</a><form data-n11-src="admin/exam/detail.jsp|18" method="post" action="${pageContext.request.contextPath}/admin/exams/${paper.id}/publish"><input data-n11-src="admin/exam/detail.jsp|19" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><input data-n11-src="admin/exam/detail.jsp|20" type="hidden" name="published" value="${not paper.is_published}"/><button data-n11-src="admin/exam/detail.jsp|21" class="btn btn-primary" type="submit">${paper.is_published ? 'Ẩn đề' : 'Công bố đề'}</button></form><c:if test="${editable}"><form data-n11-src="admin/exam/detail.jsp|22" method="post" action="${pageContext.request.contextPath}/admin/exams/${paper.id}/delete" onsubmit="return confirm('Xóa đề nháp và liên kết câu hỏi? Câu hỏi gốc không bị xóa.')"><input data-n11-src="admin/exam/detail.jsp|23" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><button data-n11-src="admin/exam/detail.jsp|24" class="btn btn-outline-danger">Xóa đề nháp</button></form></c:if></div>
<c:if test="${not editable}"><p data-n11-src="admin/exam/detail.jsp|25" class="small-meta mt-3 mb-0">${paper.attempt_count gt 0 ? 'Đề đã có lượt thi: khóa cấu trúc và bảng quy đổi.' : 'Hãy ẩn đề trước khi chỉnh sửa.'}</p></c:if></section><c:if test="${editable}"><details data-n11-src="admin/exam/detail.jsp|26" class="panel-card mb-4"><summary data-n11-src="admin/exam/detail.jsp|27" class="account-section-title">Thông tin đề thi</summary><form data-n11-src="admin/exam/detail.jsp|28" method="post" action="${pageContext.request.contextPath}/admin/exams/${paper.id}/edit" class="row g-3 mt-1"><input data-n11-src="admin/exam/detail.jsp|29" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/>
<div data-n11-src="admin/exam/detail.jsp|30" class="col-md-8"><label data-n11-src="admin/exam/detail.jsp|31" class="form-label" for="edit-title">Tên đề</label><input data-n11-src="admin/exam/detail.jsp|32" id="edit-title" class="form-control" name="title" maxlength="220" required value="${fn:escapeXml(paper.title)}"/></div><div data-n11-src="admin/exam/detail.jsp|33" class="col-md-4"><label data-n11-src="admin/exam/detail.jsp|34" for="edit-type" class="form-label">Loại đề</label><select data-n11-src="admin/exam/detail.jsp|35" id="edit-type" name="type" class="form-select"><option value="LR_FULL" ${paper.exam_type eq 'LR_FULL' ? 'selected' : ''}>Full Test</option><option value="LR_CUSTOM" ${paper.exam_type eq 'LR_CUSTOM' ? 'selected' : ''}>Đề tùy chọn</option></select></div><div data-n11-src="admin/exam/detail.jsp|36" class="col-md-4"><label data-n11-src="admin/exam/detail.jsp|37" for="edit-duration" class="form-label">Phút</label><input data-n11-src="admin/exam/detail.jsp|38" id="edit-duration" type="number" name="duration" class="form-control" min="1" max="180" value="${paper.duration_minutes}" required/></div><div data-n11-src="admin/exam/detail.jsp|39" class="col-md-8"><label data-n11-src="admin/exam/detail.jsp|40" for="edit-desc" class="form-label">Mô tả</label><textarea data-n11-src="admin/exam/detail.jsp|41" id="edit-desc" class="form-control" name="description" maxlength="5000" rows="2"><c:out value="${paper.description}"/></textarea></div><div data-n11-src="admin/exam/detail.jsp|42" class="col-12"><button data-n11-src="admin/exam/detail.jsp|43" class="btn btn-primary">Lưu thông tin</button></div></form></details></c:if><section data-n11-src="admin/exam/detail.jsp|44" class="panel-card mb-4"><h2 data-n11-src="admin/exam/detail.jsp|45" class="account-section-title">Phân bố câu hỏi</h2><div data-n11-src="admin/exam/detail.jsp|46" class="n11-exam-parts"><c:forEach items="${distribution}" var="d"><div data-n11-src="admin/exam/detail.jsp|47" class="n11-exam-part"><small data-n11-src="admin/exam/detail.jsp|48">Part ${d.part}</small><strong data-n11-src="admin/exam/detail.jsp|49">${d.count}<c:if test="${paper.exam_type eq 'LR_FULL'}"> / ${d.target}</c:if></strong></div></c:forEach></div><c:if test="${editable and paper.exam_type eq 'LR_FULL'}"><form data-n11-src="admin/exam/detail.jsp|50" action="${pageContext.request.contextPath}/admin/exams/${paper.id}/generate" method="post" class="mt-3" onsubmit="return confirm('Thay toàn bộ câu đã chọn bằng Full Test ngẫu nhiên? Bảng quy đổi cũ sẽ bị xóa.')"><input data-n11-src="admin/exam/detail.jsp|51" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><button data-n11-src="admin/exam/detail.jsp|52" class="btn btn-primary">Tạo Full Test tự động (200 câu)</button></form></c:if></section><c:if test="${editable}"><section data-n11-src="admin/exam/detail.jsp|53" class="panel-card mb-4"><h2 data-n11-src="admin/exam/detail.jsp|54" class="account-section-title">Thêm câu hỏi từ ngân hàng</h2><form data-n11-src="admin/exam/detail.jsp|55" method="get" action="${pageContext.request.contextPath}/admin/exams/${paper.id}" class="row g-3 align-items-end"><div data-n11-src="admin/exam/detail.jsp|56" class="col-md-3"><label data-n11-src="admin/exam/detail.jsp|57" for="bank-part" class="form-label">Part</label><select data-n11-src="admin/exam/detail.jsp|58" id="bank-part" class="form-select" name="part"><c:forEach begin="1" end="7" var="n"><option value="${n}" ${part eq n ? 'selected' : ''}>Part ${n}</option></c:forEach></select></div><div data-n11-src="admin/exam/detail.jsp|59" class="col-md-6"><label data-n11-src="admin/exam/detail.jsp|60" class="form-label" for="bank-q">Tìm câu hoặc bộ luyện</label><input data-n11-src="admin/exam/detail.jsp|61" id="bank-q" class="form-control" name="q" value="${fn:escapeXml(q)}" maxlength="220"/></div><div data-n11-src="admin/exam/detail.jsp|62" class="col-md-3"><button data-n11-src="admin/exam/detail.jsp|63" class="btn btn-soft w-100">Lọc câu hỏi</button></div></form>
<form data-n11-src="admin/exam/detail.jsp|64" class="d-flex flex-wrap align-items-end gap-2 my-3" method="post" action="${pageContext.request.contextPath}/admin/exams/${paper.id}/random"><input data-n11-src="admin/exam/detail.jsp|65" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><input data-n11-src="admin/exam/detail.jsp|66" type="hidden" name="part" value="${part}"/><div data-n11-src="admin/exam/detail.jsp|67"><label data-n11-src="admin/exam/detail.jsp|68" for="random-amount" class="form-label">Số câu ngẫu nhiên · Part ${part}</label><input data-n11-src="admin/exam/detail.jsp|69" id="random-amount" class="form-control" name="amount" type="number" min="1" max="200" value="${part eq 3 or part eq 4 ? 3 : part eq 6 ? 4 : part eq 7 ? 2 : 1}" required/></div><button data-n11-src="admin/exam/detail.jsp|70" class="btn btn-primary">Thêm ngẫu nhiên</button></form>
<form data-n11-src="admin/exam/detail.jsp|71" method="post" action="${pageContext.request.contextPath}/admin/exams/${paper.id}/add"><input data-n11-src="admin/exam/detail.jsp|72" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><input data-n11-src="admin/exam/detail.jsp|73" type="hidden" name="part" value="${part}"/><div data-n11-src="admin/exam/detail.jsp|74" class="table-responsive"><table data-n11-src="admin/exam/detail.jsp|75" class="table align-middle"><thead data-n11-src="admin/exam/detail.jsp|76"><tr data-n11-src="admin/exam/detail.jsp|77"><th data-n11-src="admin/exam/detail.jsp|78">Chọn</th><th data-n11-src="admin/exam/detail.jsp|79">Bộ luyện / câu đầu nhóm</th><th data-n11-src="admin/exam/detail.jsp|80">Số câu</th></tr></thead><tbody data-n11-src="admin/exam/detail.jsp|81"><c:forEach items="${candidates}" var="g"><tr data-n11-src="admin/exam/detail.jsp|82"><td data-n11-src="admin/exam/detail.jsp|83"><input data-n11-src="admin/exam/detail.jsp|84" class="form-check-input" type="checkbox" name="groupIds" value="${g.id}" aria-label="Chọn nhóm ${g.id}"/></td><td data-n11-src="admin/exam/detail.jsp|85"><strong data-n11-src="admin/exam/detail.jsp|86"><c:out value="${g.title}"/></strong><small data-n11-src="admin/exam/detail.jsp|87" class="d-block"><c:out value="${g.sample}"/> · #${g.id}</small></td><td data-n11-src="admin/exam/detail.jsp|88">${g.size}</td></tr></c:forEach><c:if test="${empty candidates}"><tr data-n11-src="admin/exam/detail.jsp|89"><td data-n11-src="admin/exam/detail.jsp|90" colspan="3" class="text-center py-3">Không có nhóm câu hợp lệ chưa được chọn.</td></tr></c:if></tbody></table></div><button data-n11-src="admin/exam/detail.jsp|91" class="btn btn-primary" ${empty candidates ? 'disabled' : ''}>Thêm nhóm đã chọn</button></form>
<div data-n11-src="admin/exam/detail.jsp|92" class="d-flex gap-2 mt-3"><c:if test="${page gt 0}"><a data-n11-src="admin/exam/detail.jsp|93" class="btn btn-soft btn-sm" href="<c:url value='/admin/exams/${paper.id}'><c:param name='part' value='${part}'/><c:param name='q' value='${q}'/><c:param name='page' value='${page-1}'/></c:url>">← Trước</a></c:if><c:if test="${more}"><a data-n11-src="admin/exam/detail.jsp|94" class="btn btn-soft btn-sm" href="<c:url value='/admin/exams/${paper.id}'><c:param name='part' value='${part}'/><c:param name='q' value='${q}'/><c:param name='page' value='${page+1}'/></c:url>">Sau →</a></c:if></div><small data-n11-src="admin/exam/detail.jsp|95" class="small-meta d-block mt-2">Chỉ lấy nhóm đủ đáp án và học liệu đã công bố. Đổi danh sách câu sẽ xóa bảng quy đổi cũ.</small></section></c:if><section data-n11-src="admin/exam/detail.jsp|96" class="panel-card mb-4"><h2 data-n11-src="admin/exam/detail.jsp|97" class="account-section-title">Câu hỏi trong đề</h2><div data-n11-src="admin/exam/detail.jsp|98" class="table-responsive"><table data-n11-src="admin/exam/detail.jsp|99" class="table align-middle"><thead data-n11-src="admin/exam/detail.jsp|100"><tr data-n11-src="admin/exam/detail.jsp|101"><th data-n11-src="admin/exam/detail.jsp|102">Thứ tự</th><th data-n11-src="admin/exam/detail.jsp|103">Part</th><th data-n11-src="admin/exam/detail.jsp|104">Nhóm câu</th><th data-n11-src="admin/exam/detail.jsp|105">Số câu</th><th data-n11-src="admin/exam/detail.jsp|106">Thao tác</th></tr></thead><tbody data-n11-src="admin/exam/detail.jsp|107"><c:forEach items="${groups}" var="g"><tr data-n11-src="admin/exam/detail.jsp|108"><td data-n11-src="admin/exam/detail.jsp|109">${g.start}–${g.end}</td><td data-n11-src="admin/exam/detail.jsp|110">${g.part}</td><td data-n11-src="admin/exam/detail.jsp|111"><strong data-n11-src="admin/exam/detail.jsp|112"><c:out value="${g.title}"/></strong><small data-n11-src="admin/exam/detail.jsp|113" class="d-block"><c:out value="${g.sample}"/></small></td><td data-n11-src="admin/exam/detail.jsp|114">${g.size}</td><td data-n11-src="admin/exam/detail.jsp|115"><c:if test="${editable}"><form data-n11-src="admin/exam/detail.jsp|116" method="post" action="${pageContext.request.contextPath}/admin/exams/${paper.id}/remove"><input data-n11-src="admin/exam/detail.jsp|117" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><input data-n11-src="admin/exam/detail.jsp|118" type="hidden" name="question" value="${g.id}"/><button data-n11-src="admin/exam/detail.jsp|119" class="btn btn-outline-danger btn-sm">Bỏ nhóm</button></form></c:if></td></tr></c:forEach><c:if test="${empty groups}"><tr data-n11-src="admin/exam/detail.jsp|120"><td data-n11-src="admin/exam/detail.jsp|121" colspan="5" class="text-center py-3">Chưa có câu hỏi.</td></tr></c:if></tbody></table></div></section>
<c:if test="${paper.exam_type eq 'LR_FULL'}"><details data-n11-src="admin/exam/detail.jsp|122" class="panel-card mb-4"><summary data-n11-src="admin/exam/detail.jsp|123" class="account-section-title">Bảng quy đổi điểm · ${paper.scale_count eq 202 ? 'Đã nhập' : 'Chưa có bảng đầy đủ'}</summary><p data-n11-src="admin/exam/detail.jsp|124" class="small-meta mt-3">Nhập thang điểm có căn cứ của đề; mỗi kỹ năng 101 dòng từ 0 đến 100 câu đúng, dạng 0=5. Không tự sinh điểm TOEIC. Để trống cả hai nếu chưa có bảng.</p><c:if test="${editable}"><form data-n11-src="admin/exam/detail.jsp|125" class="row g-3" method="post" action="${pageContext.request.contextPath}/admin/exams/${paper.id}/scales"><input data-n11-src="admin/exam/detail.jsp|126" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><div data-n11-src="admin/exam/detail.jsp|127" class="col-md-6"><label data-n11-src="admin/exam/detail.jsp|128" class="form-label" for="scale-l">Listening</label><textarea data-n11-src="admin/exam/detail.jsp|129" id="scale-l" class="form-control n11-exam-scale" name="listening" rows="9" maxlength="3000"><c:out value="${listeningScale}"/></textarea></div><div data-n11-src="admin/exam/detail.jsp|130" class="col-md-6"><label data-n11-src="admin/exam/detail.jsp|131" class="form-label" for="scale-r">Reading</label><textarea data-n11-src="admin/exam/detail.jsp|132" id="scale-r" class="form-control n11-exam-scale" name="reading" rows="9" maxlength="3000"><c:out value="${readingScale}"/></textarea></div><div data-n11-src="admin/exam/detail.jsp|133" class="col-12"><button data-n11-src="admin/exam/detail.jsp|134" class="btn btn-primary">Lưu bảng quy đổi</button></div></form></c:if></details></c:if>
</div></div></div></main>
