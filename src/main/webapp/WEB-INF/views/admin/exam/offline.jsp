<%@ page pageEncoding="UTF-8" %>
<%@ include file="../../fragments/head.jspf" %>
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/admin-exams-v33.css"/>
<c:if test="${running}"><script>setTimeout(()=>location.reload(),3500);</script></c:if>
<main data-n11-src="admin/exam/offline.jsp|1" class="admin-shell n11-admin-content n11-exam-admin"><div class="container container-n11"><div class="row g-4"><div class="col-lg-3"><%@ include file="../../fragments/admin-sidebar.jspf" %></div><div class="col-lg-9 n11-content-main">
<header data-n11-src="admin/exam/offline.jsp|2" class="n11-content-hero"><div><h1 class="account-title">Nguồn học liệu offline</h1><p class="small-meta">Nhập nguyên bộ đề từ kho cục bộ, không upload Cloudinary.</p></div><a class="btn btn-soft" href="${pageContext.request.contextPath}/admin/exams">← Ngân hàng đề</a></header>
<c:if test="${not empty successMessage}"><div class="alert alert-success"><c:out value="${successMessage}"/></div></c:if><c:if test="${not empty errorMessage}"><div class="alert alert-danger"><c:out value="${errorMessage}"/></div></c:if>
<section data-n11-src="admin/exam/offline.jsp|3" class="panel-card"><h2 class="account-section-title">Lưu trữ media mới</h2><form method="post" action="${pageContext.request.contextPath}/admin/exams/offline/mode" class="d-flex flex-wrap align-items-center gap-3"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><label><input type="radio" name="mode" value="LOCAL" ${mode eq 'LOCAL' ? 'checked' : ''}/> Local / Offline</label><label><input type="radio" name="mode" value="CLOUD" ${mode eq 'CLOUD' ? 'checked' : ''}/> Cloudinary</label><button class="btn btn-primary" type="submit">Lưu lựa chọn</button></form><p class="small-meta mt-3 mb-0">Áp dụng cho media Listening tải mới. Nhập đề offline luôn dùng Local. URL media đã lưu không bị thay đổi.</p></section>
<section class="panel-card mb-3"><h2 class="account-section-title">Đồng bộ tài nguyên dùng chung</h2><p>Chuyển media Local đã nhập vào MySQL sang URL Cloudinary để thành viên khác chạy được mà không cần thư mục media.</p><a class="btn btn-primary" href="${pageContext.request.contextPath}/admin/exams/offline/media-sync">Đồng bộ Local lên Cloudinary</a></section>
<section data-n11-src="admin/exam/offline.jsp|4" class="panel-card"><h2 class="account-section-title">Kho dữ liệu</h2><p><code><c:out value="${root}"/></code></p><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Nguồn</th><th>Trạng thái</th><th>Vai trò</th></tr></thead><tbody><tr><td>content.db</td><td>${contentReady ? 'Có file' : 'Chưa có'}</td><td>Từ vựng, tài liệu (chỉ kiểm kê)</td></tr><tr><td>toeic.db</td><td>${toeicReady ? 'Có file' : 'Chưa có'}</td><td>Ngân hàng câu hỏi (chỉ kiểm kê)</td></tr><tr><td>raw/</td><td>${rawReady ? 'Có thư mục' : 'Chưa có'}</td><td>Đề gốc và nhóm câu</td></tr><tr><td>media/</td><td>${mediaReady ? 'Có thư mục' : 'Chưa có'}</td><td>Audio, hình ảnh</td></tr></tbody></table></div><p class="small-meta">Thư mục lưu media: <code><c:out value="${media}"/></code></p><form method="post" action="${pageContext.request.contextPath}/admin/exams/offline/scan"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><button class="btn btn-soft" ${running or not rawReady ? 'disabled' : ''}>1. Quét dữ liệu</button></form><form class="mt-3" method="post" action="${pageContext.request.contextPath}/admin/exams/offline/apply"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><label class="d-flex align-items-start gap-2 mb-3"><input type="checkbox" required name="confirmed" value="true"/> Tôi có quyền sử dụng học liệu và đã sao lưu MySQL.</label><button class="btn btn-primary" ${running or not scanned ? 'disabled' : ''}>2. Nhập bản nháp vào MySQL</button></form></section>
<section data-n11-src="admin/exam/offline.jsp|5" class="panel-card"><h2 class="account-section-title"><c:out value="${status}"/></h2><pre style="white-space:pre-wrap;overflow-wrap:anywhere;max-height:400px;overflow:auto"><c:out value="${output}"/></pre><p class="small-meta">Báo cáo chi tiết nằm tại .local/n11-offline-import trên máy chủ. Đề thiếu media hoặc không đủ nhóm sẽ không được công bố tự động.</p></section>
</div></div></div></main><%@ include file="../../fragments/scripts.jspf" %>
