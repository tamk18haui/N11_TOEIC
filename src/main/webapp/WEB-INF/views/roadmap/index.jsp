<%@ page pageEncoding="UTF-8" %>
<%@ include file="../fragments/head.jspf" %>
<%@ include file="../fragments/header.jspf" %>
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/study-tracking.css"/>
<main class="page-section n11-tracking"><div class="container container-n11">
<section class="reading-admin-hero mb-4"><div><h1>Lộ trình học TOEIC</h1><p>Kế hoạch học tập cá nhân và những nhiệm vụ được giao.</p></div></section>
<c:if test="${not empty successMessage}"><div class="alert alert-success"><c:out value="${successMessage}"/></div></c:if><c:if test="${not empty errorMessage}"><div class="alert alert-danger"><c:out value="${errorMessage}"/></div></c:if><c:if test="${empty plans}"><section class="panel-card"><h2>Chưa có lộ trình được giao</h2><p>Bạn có thể bắt đầu học từ vựng, ngữ pháp hoặc luyện nghe đọc trong lúc chờ Admin tạo kế hoạch.</p><a class="btn btn-primary" href="${pageContext.request.contextPath}/grammar">Bắt đầu học</a></section></c:if>
<c:forEach items="${plans}" var="p"><section class="panel-card mb-4"><div class="d-flex flex-wrap justify-content-between align-items-center"><h2><c:out value="${p.title}"/></h2><span class="pill pill-green">Mục tiêu ${p.target_score}</span></div><p>${p.start_date} — ${p.target_date} · <c:choose><c:when test="${p.status eq 'ACTIVE'}">Đang học</c:when><c:when test="${p.status eq 'COMPLETED'}">Hoàn thành</c:when><c:otherwise>Lưu trữ</c:otherwise></c:choose></p><p>Đã đánh dấu hoàn thành ${p.done_count}/${p.item_count} nhiệm vụ</p><progress class="n11-meter" value="${p.done_count}" max="${p.item_count gt 0 ? p.item_count : 1}"></progress><div class="n11-task-list"><c:forEach items="${p.tasks}" var="i"><div class="n11-task"><div><strong><c:out value="${i.title}"/></strong><small class="d-block">Hạn: <c:out value="${i.due_date}" default="Không giới hạn"/></small><small>${i.is_completed ? 'Đã đánh dấu hoàn thành' : 'Chưa hoàn thành'}</small></div><div class="d-flex flex-wrap gap-2"><c:if test="${i.published}"><a class="btn btn-soft btn-sm" href="${pageContext.request.contextPath}${i.link}">Học ngay</a></c:if><c:if test="${not i.published}"><span>Học liệu chưa công bố</span></c:if><c:if test="${p.status eq 'ACTIVE'}"><form method="post" action="${pageContext.request.contextPath}/roadmap/items/${i.id}"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/><input type="hidden" name="done" value="${not i.is_completed}"/><button class="btn btn-primary btn-sm">${i.is_completed ? 'Đánh dấu chưa xong' : 'Đánh dấu hoàn thành'}</button></form></c:if></div></div></c:forEach></div></section></c:forEach><a class="btn btn-soft" href="${pageContext.request.contextPath}/progress">Xem kết quả học tập thực tế</a></div></main><%@ include file="../fragments/footer.jspf" %>
<%@ include file="../fragments/scripts.jspf" %>
