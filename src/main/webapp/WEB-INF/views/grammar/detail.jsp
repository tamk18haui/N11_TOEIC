<%@ page pageEncoding="UTF-8" %>
<%@ include file="../fragments/head.jspf" %>
<%@ include file="../fragments/header.jspf" %>

<main class="grammar-page"><div class="container grammar-detail"><a class="grammar-back" href="${pageContext.request.contextPath}/grammar">← Tất cả chủ điểm</a>
<div class="lesson-heading"><div class="d-flex justify-content-between gap-3 align-items-start"><h1><c:out value="${lesson.title}"/></h1><span class="grammar-badge">${lesson.level eq 'BASIC' ? 'Cơ bản' : lesson.level eq 'INTERMEDIATE' ? 'Trung cấp' : 'Nâng cao'}</span></div><span class="small text-muted"><c:out value="${lesson.topicTitle}"/> · ${questions.size()} câu luyện tập</span><p><c:out value="${lesson.summary}"/></p></div>
<nav class="lesson-tabs" aria-label="Nội dung bài học"><a class="${tab eq 'lecture' ? 'active' : ''}" href="?tab=lecture">◎ Bài giảng</a><a class="examples ${tab eq 'examples' ? 'active' : ''}" href="?tab=examples">✎ Ví dụ</a><a class="exercises ${tab eq 'exercises' ? 'active' : ''}" href="?tab=exercises">☷ Bài tập</a></nav>
<%@ include file="alerts.jspf" %>
<section class="lesson-panel"><div class="lesson-panel-title"><span class="lesson-icon" aria-hidden="true">${tab eq 'lecture' ? '◎' : tab eq 'examples' ? '✎' : '☷'}</span><h2>${tab eq 'lecture' ? 'BÀI GIẢNG' : tab eq 'examples' ? 'VÍ DỤ THỰC TẾ' : 'BÀI TẬP ÁP DỤNG'}</h2></div><div class="lesson-content">
<c:choose><c:when test="${tab eq 'lecture'}"><div class="lecture">${lesson.contentHtml}</div><div class="text-end mt-4"><a class="btn grammar-btn" href="?tab=examples">Xem ví dụ →</a></div></c:when>
<c:when test="${tab eq 'examples'}"><c:forEach items="${examples}" var="example" varStatus="s"><article class="example-card"><div class="d-flex gap-3"><span class="grammar-badge align-self-start">${s.index+1}</span><div class="flex-grow-1"><h3><c:out value="${example.sentence}"/></h3><p class="translation">→ <c:out value="${example.translation}"/></p><div class="example-note"><c:out value="${example.note}"/></div></div></div></article></c:forEach><div class="text-end mt-4"><a class="btn grammar-btn" href="?tab=exercises">Luyện tập ngay →</a></div></c:when>
<c:otherwise><div class="grammar-notice">Chọn một đáp án cho mỗi câu. Sau khi nộp, bạn sẽ nhận điểm và giải thích chi tiết. Câu bỏ trống được tính là chưa đúng.</div>
<c:choose><c:when test="${empty pageContext.request.userPrincipal}"><div class="grammar-empty mt-4"><h3 class="h5">Đăng nhập để làm bài và lưu kết quả</h3><a class="btn grammar-btn mt-3" href="${pageContext.request.contextPath}/login">Đăng nhập</a></div></c:when><c:otherwise>
<form id="exercise-form" method="post" action="${pageContext.request.contextPath}/grammar/${lesson.id}/submit"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
<c:forEach items="${questions}" var="question" varStatus="s"><fieldset class="exercise-card"><legend><span class="grammar-badge me-2">Câu ${s.index+1} / ${questions.size()}</span><c:out value="${question.questionText}"/></legend><div class="exercise-options"><c:forEach items="${question.options}" var="option"><label class="exercise-option"><input type="radio" name="answer_${question.id}" value="${option.id}"><strong>${option.optionLabel}</strong><span><c:out value="${option.optionText}"/></span></label></c:forEach></div></fieldset></c:forEach>
<div class="exercise-submit"><span id="answer-count" class="small text-muted" aria-live="polite">Đã chọn 0 / ${questions.size()} câu</span><button class="btn grammar-btn" type="submit" ${empty questions ? 'disabled' : ''}>Nộp bài &amp; xem kết quả →</button></div></form>
<script>document.getElementById('exercise-form').addEventListener('change',function(){document.getElementById('answer-count').textContent='Đã chọn '+this.querySelectorAll('input[type=radio]:checked').length+' / '+this.querySelectorAll('fieldset').length+' câu';});</script>
</c:otherwise></c:choose></c:otherwise></c:choose></div></section></div></main>
<%@ include file="../fragments/footer.jspf" %><%@ include file="../fragments/scripts.jspf" %>
