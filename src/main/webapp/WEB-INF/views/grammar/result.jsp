<%@ page pageEncoding="UTF-8" %>
<%@ include file="../fragments/head.jspf" %>
<%@ include file="../fragments/header.jspf" %>

<main class="grammar-page"><div class="container grammar-detail"><a class="grammar-back" href="${pageContext.request.contextPath}/grammar/history">← Lịch sử làm bài</a><section class="result-summary"><span class="grammar-eyebrow">Đã lưu kết quả của bạn</span><h1 class="h3 mt-3"><c:out value="${attempt.lessonTitle}"/></h1><div class="result-score">${attempt.scorePercent}%</div><p>Đúng <strong>${attempt.correctCount} / ${attempt.totalQuestions}</strong> câu · Điểm bài tập ngữ pháp</p><div class="d-flex flex-wrap justify-content-center gap-2"><a class="btn grammar-btn" href="${pageContext.request.contextPath}/grammar/${attempt.lessonId}?tab=exercises">Làm lại bài tập</a><a class="btn btn-outline-primary" href="${pageContext.request.contextPath}/grammar/${attempt.lessonId}">Ôn lại bài giảng</a></div></section>
<h2 class="h4 mb-4">Đáp án và giải thích</h2><c:forEach items="${answers}" var="answer" varStatus="s"><article class="result-answer ${answer.correct ? 'correct' : ''}"><div class="d-flex justify-content-between mb-2"><span class="small text-muted">Câu ${s.index+1}</span><span class="badge ${answer.correct ? 'bg-success' : 'bg-secondary'}">${answer.correct ? 'Chính xác' : empty answer.selectedText ? 'Bỏ trống' : 'Chưa đúng'}</span></div><h3><c:out value="${answer.questionText}"/></h3><p class="mb-1">Bạn chọn: <strong><c:out value="${empty answer.selectedText ? 'Chưa chọn đáp án' : answer.selectedText}"/></strong></p><p class="text-success">Đáp án đúng: <strong><c:out value="${answer.correctText}"/></strong></p><div class="example-note"><c:out value="${answer.explanation}"/></div></article></c:forEach></div></main>
<%@ include file="../fragments/footer.jspf" %><%@ include file="../fragments/scripts.jspf" %>
