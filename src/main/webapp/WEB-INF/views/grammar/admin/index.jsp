<%@ page pageEncoding="UTF-8" %>
<%@ include file="../../fragments/head.jspf" %><%@ include file="../../fragments/header.jspf" %>
<main class="grammar-page grammar-admin"><div class="container grammar-wrap">
<%@ include file="../alerts.jspf" %>

<div class="d-flex justify-content-between gap-3 flex-wrap mb-4"><div><span class="section-caption">QUẢN TRỊ NỘI DUNG</span><h1 class="h2">Ngữ pháp TOEIC</h1><p class="text-muted">Quản lý chủ điểm, bài giảng, ví dụ và bài tập.</p></div><div><a class="btn grammar-btn" href="${pageContext.request.contextPath}/admin/grammar/lessons/new">+ Thêm bài học</a></div></div>
<div class="row g-3 mb-4"><div class="col-6 col-lg-3"><div class="stat-card"><span>Bài học</span><h2>${stats.lessons}</h2></div></div><div class="col-6 col-lg-3"><div class="stat-card"><span>Câu hỏi</span><h2>${stats.questions}</h2></div></div><div class="col-6 col-lg-3"><div class="stat-card"><span>Lượt nộp bài</span><h2>${stats.attempts}</h2></div></div><div class="col-6 col-lg-3"><div class="stat-card"><span>Điểm trung bình</span><h2>${stats.average}%</h2></div></div></div>
<section class="panel-card"><h2 class="h4 mb-3">Danh sách bài học</h2><div class="table-responsive"><table class="table"><thead><tr><th>Bài học</th><th>Chủ điểm</th><th>Câu hỏi</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><c:forEach items="${lessons}" var="lesson"><tr><td><a class="fw-bold" href="${pageContext.request.contextPath}/admin/grammar/lessons/${lesson.id}"><c:out value="${lesson.title}"/></a></td><td><c:out value="${lesson.topicTitle}"/></td><td>${lesson.questionCount}</td><td><span class="badge ${lesson.published ? 'bg-success' : 'bg-secondary'}">${lesson.published ? 'Công bố' : 'Bản nháp'}</span></td><td><div class="d-flex gap-2"><a class="btn btn-sm btn-soft" href="${pageContext.request.contextPath}/admin/grammar/lessons/${lesson.id}">Sửa</a><form method="post" action="${pageContext.request.contextPath}/admin/grammar/lessons/${lesson.id}/delete" onsubmit="return confirm('Xóa bài học này? Bài đã có lượt làm sẽ được giữ lại.');"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button></form></div></td></tr></c:forEach></tbody></table></div></section>
<section class="panel-card"><h2 class="h4 mb-3">Chủ điểm ngữ pháp</h2><div class="row g-4"><div class="col-md-5"><h3 class="h6">Thêm chủ điểm</h3><form method="post" action="${pageContext.request.contextPath}/admin/grammar/topics/save"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><div class="mb-3"><label class="form-label">Tên chủ đề<input class="form-control" type="text" name="title" value="<c:out value=''/>" required maxlength="180" ></label></div><div class="mb-3"><label class="form-label w-100">Mô tả<textarea class="form-control" name="description" rows="3" maxlength="2000" ><c:out value=""/></textarea></label></div><div class="mb-3"><label class="form-label">Thứ tự<input class="form-control" type="number" name="sortOrder" value="<c:out value='0'/>" required maxlength="200" min="0"></label></div><label class="form-check mb-3"><input class="form-check-input" type="checkbox" name="published" value="true" checked> Hiển thị chủ đề</label><button class="btn btn-primary" type="submit">Thêm chủ đề</button></form></div><div class="col-md-7"><c:forEach items="${topics}" var="topic"><details class="example-card"><summary class="fw-bold"><c:out value="${topic.title}"/> <span class="small text-muted">· ${topic.published ? 'Hiển thị' : 'Ẩn'}</span></summary><div class="mt-3"><form method="post" action="${pageContext.request.contextPath}/admin/grammar/topics/save"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="id" value="${topic.id}"><div class="mb-3"><label class="form-label">Tên chủ đề<input class="form-control" type="text" name="title" value="<c:out value='${topic.title}'/>" required maxlength="180" ></label></div><div class="mb-3"><label class="form-label w-100">Mô tả<textarea class="form-control" name="description" rows="3" maxlength="2000" ><c:out value="${topic.description}"/></textarea></label></div><div class="mb-3"><label class="form-label">Thứ tự<input class="form-control" type="number" name="sortOrder" value="<c:out value='${topic.sortOrder}'/>" required maxlength="200" min="0"></label></div><label class="form-check mb-3"><input class="form-check-input" type="checkbox" name="published" value="true" ${topic.published ? 'checked' : ''}> Hiển thị chủ đề</label><button class="btn btn-primary" type="submit">Lưu chủ đề</button></form><form class="mt-2" method="post" action="${pageContext.request.contextPath}/admin/grammar/topics/${topic.id}/delete" onsubmit="return confirm('Xóa chủ đề trống này?');"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="btn btn-sm btn-outline-danger" type="submit">Xóa chủ đề</button></form></div></details></c:forEach></div></div></section></div></main>
<%@ include file="../../fragments/footer.jspf" %><%@ include file="../../fragments/scripts.jspf" %>