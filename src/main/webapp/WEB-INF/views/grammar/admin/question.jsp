<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="activePage" value="admin-grammar" scope="request" />
<%@ include file="../../fragments/head.jspf" %>
<%-- Bố cục JSP: sidebar, lưới 3/9 và nội dung. Màu/kích thước: admin-content-v19.css. --%>
<main data-n11-src="grammar/admin/question.jsp|1" class="admin-shell grammar-page grammar-admin n11-admin-content"><div data-n11-src="grammar/admin/question.jsp|2" class="container container-n11"><div data-n11-src="grammar/admin/question.jsp|3" class="row g-4">
<div data-n11-src="grammar/admin/question.jsp|4" class="col-lg-3"><%@ include file="../../fragments/admin-sidebar.jspf" %></div>
<div data-n11-src="grammar/admin/question.jsp|5" class="col-lg-9 n11-content-main">
<%@ include file="../alerts.jspf" %>

<a data-n11-src="grammar/admin/question.jsp|6" class="grammar-back" href="${pageContext.request.contextPath}/admin/grammar/lessons/${lesson.id}">← Quay lại bài học</a><h1 data-n11-src="grammar/admin/question.jsp|7" class="h2">${empty question.id ? 'Thêm câu hỏi' : 'Sửa câu hỏi'}</h1><p data-n11-src="grammar/admin/question.jsp|8"><c:out value="${lesson.title}"/></p><section data-n11-src="grammar/admin/question.jsp|9" class="panel-card"><form data-n11-src="grammar/admin/question.jsp|10" method="post" action="${pageContext.request.contextPath}/admin/grammar/lessons/${lesson.id}/questions/save"><input data-n11-src="grammar/admin/question.jsp|11" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input data-n11-src="grammar/admin/question.jsp|12" type="hidden" name="id" value="${question.id}"><div data-n11-src="grammar/admin/question.jsp|13" class="mb-3"><label data-n11-src="grammar/admin/question.jsp|14" class="form-label w-100">Nội dung câu hỏi<textarea data-n11-src="grammar/admin/question.jsp|15" class="form-control" name="questionText" rows="3" maxlength="4000" required><c:out value="${question.questionText}"/></textarea></label></div>
<p data-n11-src="grammar/admin/question.jsp|16" class="fw-bold">Bốn phương án · Chọn đúng một đáp án đúng</p><c:forEach items="${question.options}" var="option" varStatus="s"><div data-n11-src="grammar/admin/question.jsp|17" class="input-group mb-3"><label data-n11-src="grammar/admin/question.jsp|18" class="input-group-text"><input data-n11-src="grammar/admin/question.jsp|19" type="radio" name="correctLabel" value="${option.optionLabel}" ${option.correct ? 'checked' : ''} required aria-label="Chọn ${option.optionLabel} là đáp án đúng"><span data-n11-src="grammar/admin/question.jsp|20" class="ms-2">${option.optionLabel}</span></label><input data-n11-src="grammar/admin/question.jsp|21" type="hidden" name="options[${s.index}].optionLabel" value="${option.optionLabel}"><input data-n11-src="grammar/admin/question.jsp|22" class="form-control" name="options[${s.index}].optionText" value="<c:out value='${option.optionText}'/>" maxlength="2000" required aria-label="Nội dung phương án ${option.optionLabel}"></div></c:forEach><div data-n11-src="grammar/admin/question.jsp|23" class="mb-3"><label data-n11-src="grammar/admin/question.jsp|24" class="form-label w-100">Giải thích đáp án<textarea data-n11-src="grammar/admin/question.jsp|25" class="form-control" name="explanation" rows="6" maxlength="4000" required><c:out value="${question.explanation}"/></textarea></label></div><details data-n11-src="grammar/admin/question.jsp|26" class="mb-4"><summary data-n11-src="grammar/admin/question.jsp|27">Cách nhập phân tích từng phương án</summary>
<p data-n11-src="grammar/admin/question.jsp|28" class="small mt-2">Nhập đúng năm dòng dưới đây, thay phần giải thích theo nội dung câu. Mỗi phương án cần nêu vì sao đúng hoặc sai.</p>
<pre class="p-3 bg-light rounded">[PHÂN TÍCH]
[A] Giải thích phương án A.
[B] Giải thích phương án B.
[C] Giải thích phương án C.
[D] Giải thích phương án D.</pre></details><div data-n11-src="grammar/admin/question.jsp|29" class="row"><div data-n11-src="grammar/admin/question.jsp|30" class="col-md-6"><label data-n11-src="grammar/admin/question.jsp|31" class="form-label w-100">Độ khó<select data-n11-src="grammar/admin/question.jsp|32" class="form-select" name="difficulty"><option value="1" ${question.difficulty eq 1 ? 'selected' : ''}>1 · Cơ bản</option><option value="2" ${question.difficulty eq 2 ? 'selected' : ''}>2 · Trung bình</option><option value="3" ${question.difficulty eq 3 ? 'selected' : ''}>3 · Khó</option></select></label></div><div data-n11-src="grammar/admin/question.jsp|33" class="col-md-6"><div data-n11-src="grammar/admin/question.jsp|34" class="mb-3"><label data-n11-src="grammar/admin/question.jsp|35" class="form-label">Thứ tự<input data-n11-src="grammar/admin/question.jsp|36" class="form-control" type="number" name="sortOrder" value="<c:out value='${question.sortOrder}'/>" required maxlength="200" min="0"></label></div></div></div><button data-n11-src="grammar/admin/question.jsp|37" class="btn btn-primary" type="submit">Lưu câu hỏi</button></form></section></div></div></div></main>
<%@ include file="../../fragments/scripts.jspf" %>