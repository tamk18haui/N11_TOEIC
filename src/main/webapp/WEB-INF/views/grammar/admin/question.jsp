<%@ page pageEncoding="UTF-8" %>
<%@ include file="../../fragments/head.jspf" %><%@ include file="../../fragments/header.jspf" %>
<main class="grammar-page grammar-admin"><div class="container grammar-wrap">
<%@ include file="../alerts.jspf" %>

<a class="grammar-back" href="${pageContext.request.contextPath}/admin/grammar/lessons/${lesson.id}">← Quay lại bài học</a><h1 class="h2">${empty question.id ? 'Thêm câu hỏi' : 'Sửa câu hỏi'}</h1><p><c:out value="${lesson.title}"/></p><section class="panel-card"><form method="post" action="${pageContext.request.contextPath}/admin/grammar/lessons/${lesson.id}/questions/save"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="id" value="${question.id}"><div class="mb-3"><label class="form-label w-100">Nội dung câu hỏi<textarea class="form-control" name="questionText" rows="3" maxlength="4000" required><c:out value="${question.questionText}"/></textarea></label></div>
<p class="fw-bold">Bốn phương án · Chọn đúng một đáp án đúng</p><c:forEach items="${question.options}" var="option" varStatus="s"><div class="input-group mb-3"><label class="input-group-text"><input type="radio" name="correctLabel" value="${option.optionLabel}" ${option.correct ? 'checked' : ''} required aria-label="Chọn ${option.optionLabel} là đáp án đúng"><span class="ms-2">${option.optionLabel}</span></label><input type="hidden" name="options[${s.index}].optionLabel" value="${option.optionLabel}"><input class="form-control" name="options[${s.index}].optionText" value="<c:out value='${option.optionText}'/>" maxlength="2000" required aria-label="Nội dung phương án ${option.optionLabel}"></div></c:forEach><div class="mb-3"><label class="form-label w-100">Giải thích đáp án<textarea class="form-control" name="explanation" rows="3" maxlength="4000" required><c:out value="${question.explanation}"/></textarea></label></div><div class="row"><div class="col-md-6"><label class="form-label w-100">Độ khó<select class="form-select" name="difficulty"><option value="1" ${question.difficulty eq 1 ? 'selected' : ''}>1 · Cơ bản</option><option value="2" ${question.difficulty eq 2 ? 'selected' : ''}>2 · Trung bình</option><option value="3" ${question.difficulty eq 3 ? 'selected' : ''}>3 · Khó</option></select></label></div><div class="col-md-6"><div class="mb-3"><label class="form-label">Thứ tự<input class="form-control" type="number" name="sortOrder" value="<c:out value='${question.sortOrder}'/>" required maxlength="200" min="0"></label></div></div></div><button class="btn grammar-btn" type="submit">Lưu câu hỏi</button></form></section></div></main>
<%@ include file="../../fragments/footer.jspf" %><%@ include file="../../fragments/scripts.jspf" %>