<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="activePage" value="admin-grammar" scope="request" />
<%@ include file="../../fragments/head.jspf" %>
<%-- Bố cục JSP: sidebar, lưới 3/9 và nội dung. Màu/kích thước: admin-content-v19.css. --%>
<main data-n11-src="grammar/admin/lesson.jsp|1" class="admin-shell grammar-page grammar-admin n11-admin-content"><div data-n11-src="grammar/admin/lesson.jsp|2" class="container container-n11"><div data-n11-src="grammar/admin/lesson.jsp|3" class="row g-4">
<div data-n11-src="grammar/admin/lesson.jsp|4" class="col-lg-3"><%@ include file="../../fragments/admin-sidebar.jspf" %></div>
<div data-n11-src="grammar/admin/lesson.jsp|5" class="col-lg-9 n11-content-main">
<%@ include file="../alerts.jspf" %>

<a data-n11-src="grammar/admin/lesson.jsp|6" class="grammar-back" href="${pageContext.request.contextPath}/admin/grammar">← Dashboard ngữ pháp</a><h1 data-n11-src="grammar/admin/lesson.jsp|7" class="h2 mb-4">${empty lesson.id ? 'Thêm bài học' : 'Chỉnh sửa bài học'}</h1>
<div data-n11-src="grammar/admin/lesson.jsp|8" class="grammar-notice mb-4">Lưu bản nháp trước, sau đó thêm ví dụ và câu hỏi. Bài học cần đủ cả ba phần để công bố.</div>
<section data-n11-src="grammar/admin/lesson.jsp|9" class="panel-card"><form data-n11-src="grammar/admin/lesson.jsp|10" method="post" action="${pageContext.request.contextPath}/admin/grammar/lessons/save"><input data-n11-src="grammar/admin/lesson.jsp|11" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input data-n11-src="grammar/admin/lesson.jsp|12" type="hidden" name="id" value="${lesson.id}"><div data-n11-src="grammar/admin/lesson.jsp|13" class="row"><div data-n11-src="grammar/admin/lesson.jsp|14" class="col-md-8"><div data-n11-src="grammar/admin/lesson.jsp|15" class="mb-3"><label data-n11-src="grammar/admin/lesson.jsp|16" class="form-label">Tên bài học<input data-n11-src="grammar/admin/lesson.jsp|17" class="form-control" type="text" name="title" ${locked ? 'readonly' : ''} value="<c:out value='${lesson.title}'/>" required maxlength="200" ></label></div></div><div data-n11-src="grammar/admin/lesson.jsp|18" class="col-md-4"><label data-n11-src="grammar/admin/lesson.jsp|19" class="form-label w-100">Chủ điểm<select data-n11-src="grammar/admin/lesson.jsp|20" name="topicId" class="form-select" required><c:forEach items="${topics}" var="topic"><option value="${topic.id}" ${lesson.topicId eq topic.id ? 'selected' : ''}><c:out value="${topic.title}"/></option></c:forEach></select></label></div></div><div data-n11-src="grammar/admin/lesson.jsp|21" class="mb-3"><label data-n11-src="grammar/admin/lesson.jsp|22" class="form-label w-100">Mô tả ngắn<textarea data-n11-src="grammar/admin/lesson.jsp|23" class="form-control" name="summary" rows="2" maxlength="600" required><c:out value="${lesson.summary}"/></textarea></label></div><div data-n11-src="grammar/admin/lesson.jsp|24" class="mb-3"><label data-n11-src="grammar/admin/lesson.jsp|25" class="form-label w-100">Nội dung bài giảng (HTML cơ bản: h2, h3, p, ul, li, strong, table)<textarea data-n11-src="grammar/admin/lesson.jsp|26" class="form-control" name="contentHtml" rows="12" maxlength="100000" required><c:out value="${lesson.contentHtml}"/></textarea></label></div>
<div data-n11-src="grammar/admin/lesson.jsp|27" class="row"><div data-n11-src="grammar/admin/lesson.jsp|28" class="col-md-5"><label data-n11-src="grammar/admin/lesson.jsp|29" class="form-label w-100">Mức độ<select data-n11-src="grammar/admin/lesson.jsp|30" class="form-select" name="level"><option value="BASIC" ${lesson.level eq 'BASIC' ? 'selected' : ''}>Cơ bản</option><option value="INTERMEDIATE" ${lesson.level eq 'INTERMEDIATE' ? 'selected' : ''}>Trung cấp</option><option value="ADVANCED" ${lesson.level eq 'ADVANCED' ? 'selected' : ''}>Nâng cao</option></select></label></div><div data-n11-src="grammar/admin/lesson.jsp|31" class="col-md-3"><div data-n11-src="grammar/admin/lesson.jsp|32" class="mb-3"><label data-n11-src="grammar/admin/lesson.jsp|33" class="form-label">Thứ tự<input data-n11-src="grammar/admin/lesson.jsp|34" class="form-control" type="number" name="sortOrder" value="<c:out value='${lesson.sortOrder}'/>" required maxlength="200" min="0"></label></div></div><div data-n11-src="grammar/admin/lesson.jsp|35" class="col-md-4"><label data-n11-src="grammar/admin/lesson.jsp|36" class="form-check mt-4"><input data-n11-src="grammar/admin/lesson.jsp|37" class="form-check-input" name="published" type="checkbox" value="true" ${lesson.published ? 'checked' : ''}> Công bố bài học</label></div></div><button data-n11-src="grammar/admin/lesson.jsp|38" class="btn btn-primary" type="submit">Lưu bài học</button><c:if test="${lesson.published}"><a data-n11-src="grammar/admin/lesson.jsp|39" class="btn btn-outline-primary ms-2" href="${pageContext.request.contextPath}/grammar/${lesson.id}">Xem trang học</a></c:if></form></section>
<c:if test="${not empty lesson.id}"><section data-n11-src="grammar/admin/lesson.jsp|40" class="panel-card"><h2 data-n11-src="grammar/admin/lesson.jsp|41" class="h4 mb-4">Ví dụ thực tế</h2><c:forEach items="${examples}" var="example"><details data-n11-src="grammar/admin/lesson.jsp|42" class="example-card"><summary data-n11-src="grammar/admin/lesson.jsp|43"><c:out value="${example.sentence}"/></summary><div data-n11-src="grammar/admin/lesson.jsp|44" class="mt-3"><form data-n11-src="grammar/admin/lesson.jsp|45" method="post" action="${pageContext.request.contextPath}/admin/grammar/lessons/${lesson.id}/examples/save"><input data-n11-src="grammar/admin/lesson.jsp|46" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input data-n11-src="grammar/admin/lesson.jsp|47" type="hidden" name="id" value="${example.id}"><div data-n11-src="grammar/admin/lesson.jsp|48" class="mb-3"><label data-n11-src="grammar/admin/lesson.jsp|49" class="form-label w-100">Câu tiếng Anh<textarea data-n11-src="grammar/admin/lesson.jsp|50" class="form-control" name="sentence" rows="2" maxlength="2000" required><c:out value="${example.sentence}"/></textarea></label></div><div data-n11-src="grammar/admin/lesson.jsp|51" class="mb-3"><label data-n11-src="grammar/admin/lesson.jsp|52" class="form-label w-100">Bản dịch tiếng Việt<textarea data-n11-src="grammar/admin/lesson.jsp|53" class="form-control" name="translation" rows="2" maxlength="2000" required><c:out value="${example.translation}"/></textarea></label></div><div data-n11-src="grammar/admin/lesson.jsp|54" class="mb-3"><label data-n11-src="grammar/admin/lesson.jsp|55" class="form-label w-100">Giải thích<textarea data-n11-src="grammar/admin/lesson.jsp|56" class="form-control" name="note" rows="2" maxlength="2000" ><c:out value="${example.note}"/></textarea></label></div><div data-n11-src="grammar/admin/lesson.jsp|57" class="mb-3"><label data-n11-src="grammar/admin/lesson.jsp|58" class="form-label">Thứ tự<input data-n11-src="grammar/admin/lesson.jsp|59" class="form-control" type="number" name="sortOrder" value="<c:out value='${example.sortOrder}'/>" required maxlength="200" min="0"></label></div><button data-n11-src="grammar/admin/lesson.jsp|60" class="btn btn-primary" type="submit">Lưu ví dụ</button></form><form data-n11-src="grammar/admin/lesson.jsp|61" class="mt-2" method="post" action="${pageContext.request.contextPath}/admin/grammar/lessons/${lesson.id}/examples/${example.id}/delete" onsubmit="return confirm('Xóa ví dụ này?');"><input data-n11-src="grammar/admin/lesson.jsp|62" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button data-n11-src="grammar/admin/lesson.jsp|63" class="btn btn-sm btn-outline-danger" type="submit">Xóa ví dụ</button></form></div></details></c:forEach><details data-n11-src="grammar/admin/lesson.jsp|64" class="example-card"><summary data-n11-src="grammar/admin/lesson.jsp|65" class="fw-bold">+ Thêm ví dụ mới</summary><div data-n11-src="grammar/admin/lesson.jsp|66" class="mt-3"><form data-n11-src="grammar/admin/lesson.jsp|67" method="post" action="${pageContext.request.contextPath}/admin/grammar/lessons/${lesson.id}/examples/save"><input data-n11-src="grammar/admin/lesson.jsp|68" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><div data-n11-src="grammar/admin/lesson.jsp|69" class="mb-3"><label data-n11-src="grammar/admin/lesson.jsp|70" class="form-label w-100">Câu tiếng Anh<textarea data-n11-src="grammar/admin/lesson.jsp|71" class="form-control" name="sentence" rows="2" maxlength="2000" required><c:out value=""/></textarea></label></div><div data-n11-src="grammar/admin/lesson.jsp|72" class="mb-3"><label data-n11-src="grammar/admin/lesson.jsp|73" class="form-label w-100">Bản dịch tiếng Việt<textarea data-n11-src="grammar/admin/lesson.jsp|74" class="form-control" name="translation" rows="2" maxlength="2000" required><c:out value=""/></textarea></label></div><div data-n11-src="grammar/admin/lesson.jsp|75" class="mb-3"><label data-n11-src="grammar/admin/lesson.jsp|76" class="form-label w-100">Giải thích<textarea data-n11-src="grammar/admin/lesson.jsp|77" class="form-control" name="note" rows="2" maxlength="2000" ><c:out value=""/></textarea></label></div><div data-n11-src="grammar/admin/lesson.jsp|78" class="mb-3"><label data-n11-src="grammar/admin/lesson.jsp|79" class="form-label">Thứ tự<input data-n11-src="grammar/admin/lesson.jsp|80" class="form-control" type="number" name="sortOrder" value="<c:out value='0'/>" required maxlength="200" min="0"></label></div><button data-n11-src="grammar/admin/lesson.jsp|81" class="btn btn-primary" type="submit">Thêm ví dụ</button></form></div></details></section>
<section data-n11-src="grammar/admin/lesson.jsp|82" class="panel-card"><div data-n11-src="grammar/admin/lesson.jsp|83" class="d-flex justify-content-between gap-3 mb-3"><h2 data-n11-src="grammar/admin/lesson.jsp|84" class="h4">Bài tập trắc nghiệm</h2><c:if test="${not locked}"><a data-n11-src="grammar/admin/lesson.jsp|85" class="btn btn-soft" href="${pageContext.request.contextPath}/admin/grammar/lessons/${lesson.id}/questions/new">+ Thêm câu hỏi</a></c:if></div><c:if test="${locked}"><div data-n11-src="grammar/admin/lesson.jsp|86" class="grammar-notice mb-3">Bài đã có lượt làm. Bộ câu hỏi được khóa để giữ nguyên lịch sử; tạo bài học mới nếu cần thay đổi.</div></c:if><c:forEach items="${questions}" var="question" varStatus="s"><div data-n11-src="grammar/admin/lesson.jsp|87" class="example-card"><h3 data-n11-src="grammar/admin/lesson.jsp|88">Câu ${s.index+1}. <c:out value="${question.questionText}"/></h3><ul data-n11-src="grammar/admin/lesson.jsp|89" class="mb-2"><c:forEach items="${question.options}" var="option"><li data-n11-src="grammar/admin/lesson.jsp|90" class="${option.correct ? 'text-success fw-bold' : ''}">${option.optionLabel}. <c:out value="${option.optionText}"/> ${option.correct ? '✓' : ''}</li></c:forEach></ul><p data-n11-src="grammar/admin/lesson.jsp|91" class="small text-muted"><c:out value="${question.explanation}"/></p><c:if test="${not locked}"><div data-n11-src="grammar/admin/lesson.jsp|92" class="d-flex gap-2"><a data-n11-src="grammar/admin/lesson.jsp|93" class="btn btn-sm btn-soft" href="${pageContext.request.contextPath}/admin/grammar/lessons/${lesson.id}/questions/${question.id}">Sửa câu hỏi</a><form data-n11-src="grammar/admin/lesson.jsp|94" method="post" action="${pageContext.request.contextPath}/admin/grammar/lessons/${lesson.id}/questions/${question.id}/delete" onsubmit="return confirm('Xóa câu hỏi và bốn phương án?');"><input data-n11-src="grammar/admin/lesson.jsp|95" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button data-n11-src="grammar/admin/lesson.jsp|96" type="submit" class="btn btn-sm btn-outline-danger">Xóa</button></form></div></c:if></div></c:forEach></section></c:if></div></div></div></main>
