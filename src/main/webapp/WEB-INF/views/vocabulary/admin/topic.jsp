<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="activePage" value="admin-vocabulary" scope="request" />
<%@ include file="../../fragments/head.jspf" %>
<%-- Bố cục JSP: sidebar, lưới 3/9 và nội dung. Màu/kích thước: admin-content-v19.css. --%>
<main data-n11-src="vocabulary/admin/topic.jsp|1" class="admin-shell grammar-page grammar-admin n11-admin-content"><div data-n11-src="vocabulary/admin/topic.jsp|2" class="container container-n11"><div data-n11-src="vocabulary/admin/topic.jsp|3" class="row g-4">
<div data-n11-src="vocabulary/admin/topic.jsp|4" class="col-lg-3"><%@ include file="../../fragments/admin-sidebar.jspf" %></div>
<div data-n11-src="vocabulary/admin/topic.jsp|5" class="col-lg-9 n11-content-main">
<%@ include file="../../grammar/alerts.jspf" %>
<a data-n11-src="vocabulary/admin/topic.jsp|6" class="grammar-back" href="${pageContext.request.contextPath}/admin/vocabulary">← Dashboard từ vựng</a>
<h1 data-n11-src="vocabulary/admin/topic.jsp|7" class="h2 mb-4">${empty topic.id ? 'Thêm chủ đề' : 'Chỉnh sửa chủ đề'}</h1>
<section data-n11-src="vocabulary/admin/topic.jsp|8" class="panel-card"><form data-n11-src="vocabulary/admin/topic.jsp|9" method="post" action="${pageContext.request.contextPath}/admin/vocabulary/topics/save">
  <input data-n11-src="vocabulary/admin/topic.jsp|10" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input data-n11-src="vocabulary/admin/topic.jsp|11" type="hidden" name="id" value="${topic.id}">
  <div data-n11-src="vocabulary/admin/topic.jsp|12" class="row"><div data-n11-src="vocabulary/admin/topic.jsp|13" class="col-md-8 mb-3"><label data-n11-src="vocabulary/admin/topic.jsp|14" class="form-label w-100">Tên chủ đề<input data-n11-src="vocabulary/admin/topic.jsp|15" class="form-control" type="text" name="title" value="<c:out value='${topic.title}'/>" required maxlength="180"></label></div>
  <div data-n11-src="vocabulary/admin/topic.jsp|16" class="col-md-4 mb-3"><label data-n11-src="vocabulary/admin/topic.jsp|17" class="form-label w-100">Mức độ<select data-n11-src="vocabulary/admin/topic.jsp|18" class="form-select" name="level"><option value="BASIC" ${topic.level eq 'BASIC' ? 'selected' : ''}>Cơ bản</option><option value="INTERMEDIATE" ${topic.level eq 'INTERMEDIATE' ? 'selected' : ''}>Trung cấp</option><option value="ADVANCED" ${topic.level eq 'ADVANCED' ? 'selected' : ''}>Nâng cao</option></select></label></div></div>
  <div data-n11-src="vocabulary/admin/topic.jsp|19" class="mb-3"><label data-n11-src="vocabulary/admin/topic.jsp|20" class="form-label w-100">Mô tả<textarea data-n11-src="vocabulary/admin/topic.jsp|21" class="form-control" name="description" rows="3" maxlength="2000"><c:out value="${topic.description}"/></textarea></label></div>
  <div data-n11-src="vocabulary/admin/topic.jsp|22" class="row"><div data-n11-src="vocabulary/admin/topic.jsp|23" class="col-md-3 mb-3"><label data-n11-src="vocabulary/admin/topic.jsp|24" class="form-label w-100">Thứ tự<input data-n11-src="vocabulary/admin/topic.jsp|25" class="form-control" type="number" name="sortOrder" min="0" value="${topic.sortOrder}" required></label></div><div data-n11-src="vocabulary/admin/topic.jsp|26" class="col-md-4"><label data-n11-src="vocabulary/admin/topic.jsp|27" class="form-check mt-4"><input data-n11-src="vocabulary/admin/topic.jsp|28" class="form-check-input" name="published" type="checkbox" value="true" ${topic.published ? 'checked' : ''}> Công bố chủ đề</label></div></div>
  <button data-n11-src="vocabulary/admin/topic.jsp|29" class="btn btn-primary" type="submit">Lưu chủ đề</button>
</form></section>

<c:if test="${not empty topic.id}">
  <section data-n11-src="vocabulary/admin/topic.jsp|30" class="panel-card"><div data-n11-src="vocabulary/admin/topic.jsp|31" class="d-flex justify-content-between align-items-center mb-3"><h2 data-n11-src="vocabulary/admin/topic.jsp|32" class="h4 m-0">Bài học</h2><a data-n11-src="vocabulary/admin/topic.jsp|33" class="btn btn-soft" href="${pageContext.request.contextPath}/admin/vocabulary/topics/${topic.id}/lessons/new">+ Thêm bài học</a></div>
  <c:forEach items="${lessons}" var="lesson"><div data-n11-src="vocabulary/admin/topic.jsp|34" class="example-card d-flex justify-content-between gap-3"><div data-n11-src="vocabulary/admin/topic.jsp|35"><strong data-n11-src="vocabulary/admin/topic.jsp|36"><c:out value="${lesson.title}"/></strong><div data-n11-src="vocabulary/admin/topic.jsp|37" class="small text-muted">Mục tiêu ${lesson.targetWordCount} từ · Thứ tự ${lesson.sortOrder}</div></div><a data-n11-src="vocabulary/admin/topic.jsp|38" class="btn btn-sm btn-soft" href="${pageContext.request.contextPath}/admin/vocabulary/topics/${topic.id}/lessons/${lesson.id}">Sửa</a></div></c:forEach></section>
  <section data-n11-src="vocabulary/admin/topic.jsp|39" class="panel-card"><div data-n11-src="vocabulary/admin/topic.jsp|40" class="d-flex justify-content-between align-items-center mb-3"><div data-n11-src="vocabulary/admin/topic.jsp|41"><h2 data-n11-src="vocabulary/admin/topic.jsp|42" class="h4 m-0">Kho từ vựng</h2><p data-n11-src="vocabulary/admin/topic.jsp|43" class="text-muted small mb-0">Tối thiểu 30 từ cho mỗi chủ đề.</p></div><a data-n11-src="vocabulary/admin/topic.jsp|44" class="btn btn-soft" href="${pageContext.request.contextPath}/admin/vocabulary/topics/${topic.id}/terms/new">+ Thêm từ</a></div>
  <div data-n11-src="vocabulary/admin/topic.jsp|45" class="grammar-notice mb-3">${terms.size()} / tối thiểu 30 từ</div>
  <div data-n11-src="vocabulary/admin/topic.jsp|46" class="admin-table-wrap"><table data-n11-src="vocabulary/admin/topic.jsp|47" class="table"><thead data-n11-src="vocabulary/admin/topic.jsp|48"><tr data-n11-src="vocabulary/admin/topic.jsp|49"><th data-n11-src="vocabulary/admin/topic.jsp|50">Từ</th><th data-n11-src="vocabulary/admin/topic.jsp|51">Nghĩa</th><th data-n11-src="vocabulary/admin/topic.jsp|52">Ví dụ</th><th data-n11-src="vocabulary/admin/topic.jsp|53"></th></tr></thead><tbody data-n11-src="vocabulary/admin/topic.jsp|54"><c:forEach items="${terms}" var="term"><tr data-n11-src="vocabulary/admin/topic.jsp|55"><td data-n11-src="vocabulary/admin/topic.jsp|56"><strong data-n11-src="vocabulary/admin/topic.jsp|57"><c:out value="${term.word}"/></strong><div data-n11-src="vocabulary/admin/topic.jsp|58" class="small text-muted"><c:out value="${term.ipa}"/></div></td><td data-n11-src="vocabulary/admin/topic.jsp|59"><c:out value="${term.meaningVi}"/></td><td data-n11-src="vocabulary/admin/topic.jsp|60"><c:out value="${term.exampleEn}"/></td><td data-n11-src="vocabulary/admin/topic.jsp|61"><a data-n11-src="vocabulary/admin/topic.jsp|62" class="btn btn-sm btn-soft" href="${pageContext.request.contextPath}/admin/vocabulary/topics/${topic.id}/terms/${term.id}">Sửa</a></td></tr></c:forEach></tbody></table></div></section>
  <form data-n11-src="vocabulary/admin/topic.jsp|63" method="post" action="${pageContext.request.contextPath}/admin/vocabulary/topics/${topic.id}/delete" onsubmit="return confirm('Chỉ xóa được chủ đề trống. Tiếp tục?');"><input data-n11-src="vocabulary/admin/topic.jsp|64" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button data-n11-src="vocabulary/admin/topic.jsp|65" class="btn btn-outline-danger" type="submit">Xóa chủ đề</button></form>
</c:if>
</div></div></div></main>
<%@ include file="../../fragments/scripts.jspf" %>
