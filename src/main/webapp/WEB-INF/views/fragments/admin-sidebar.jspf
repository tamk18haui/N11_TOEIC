  <div data-n11-src="fragments/admin-sidebar.jspf|3" class="admin-nav-avatar">N11</div>
  <div data-n11-src="fragments/admin-sidebar.jspf|4"><strong data-n11-src="fragments/admin-sidebar.jspf|5">N11 TOEIC Admin</strong><span data-n11-src="fragments/admin-sidebar.jspf|6">H&#7879; th&#7889;ng qu&#7843;n tr&#7883;</span></div>
 </div>
 <div data-n11-src="fragments/admin-sidebar.jspf|7" class="admin-nav-intro"><span data-n11-src="fragments/admin-sidebar.jspf|8" class="admin-online-dot" aria-hidden="true"></span>Qu&#7843;n l&#253; h&#7885;c vi&#234;n v&#224; n&#7897;i dung TOEIC</div>

