 <form data-n11-src="fragments/admin-sidebar.jspf|25" method="post" action="${pageContext.request.contextPath}/logout" class="admin-logout-form">
  <%-- CSRF token bảo vệ yêu cầu POST. --%><input data-n11-src="fragments/admin-sidebar.jspf|26" type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}" />
  <button data-n11-src="fragments/admin-sidebar.jspf|27" type="submit" class="btn btn-soft w-100">&#272;&#259;ng xu&#7845;t</button>
 </form>
